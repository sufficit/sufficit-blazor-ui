@inherits DemoBase

<SUIStack Spacing="4">
<SUIStack Row Wrap>
<SUIButton StartIcon="@SUIIcons.Save" EndIcon="@SUIIcons.ChevronRight" OnClick="Notify">Salvar alterações</SUIButton>
<SUIButton VariantValue="SUIVariant.Soft" OnClick="Notify">Suave</SUIButton>
<SUIButton VariantValue="SUIVariant.Outlined" OnClick="Reset">Cancelar</SUIButton>
<SUIButton Disabled>Indisponível</SUIButton>
</SUIStack>

<SUIStack Style="max-width:320px">
    <SUIButton VariantValue="SUIVariant.Outlined" FullWidth Style="justify-content:flex-start;text-align:start">
        Ação alinhada ao início
    </SUIButton>
    <SUIButton VariantValue="SUIVariant.Outlined" FullWidth Style="justify-content:space-between;text-align:start">
        <span>Conferir resultado</span>
        <SUIIcon Name="arrow-right" Size="18" />
    </SUIButton>
</SUIStack>

<SUIButton VariantValue="SUIVariant.Outlined" FullWidth Style="max-width:280px;justify-content:flex-start;text-align:start" data-testid="button-long-content">
    relatorio_financeiro_e_reconciliacao_detalhada_das_notas_fiscais_de_todos_os_fornecedores
</SUIButton>
</SUIStack>
