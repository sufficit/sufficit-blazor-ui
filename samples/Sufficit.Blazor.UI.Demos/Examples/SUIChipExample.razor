@inherits DemoBase

<SUIStack Row Wrap>
<SUIChip ColorValue="SUIColor.Primary">Produção</SUIChip>
<SUIChip VariantValue="SUIVariant.Outlined">Manutenção</SUIChip>
</SUIStack>

<SUIStack Row Wrap Spacing="3" data-testid="wrapped-filter-chips">
    <SUIChip Wrap SizeValue="SUISize.Small" OnClick="EditWrapped" OnRemove="RemoveWrapped"
        ActionLabel="Editar período do exemplo" RemoveLabel="Remover período do exemplo">Período: 17/11/2026 00:00 até 17/11/2026 23:59 (incluindo as datas)</SUIChip>
    <SUIChip Wrap>Contexto: 11111111-1111-4111-8111-111111111111-22222222-2222-4222-8222-222222222222</SUIChip>
    <output data-testid="wrapped-chip-action">@_action</output>
</SUIStack>
@code { private string? _action; private void EditWrapped()=>_action="edit"; private void RemoveWrapped()=>_action="remove"; }
