@inherits DemoBase
<SUIFormGrid>
    <SUITextField T="string" Label="Nome" @bind-Value="Text" HelperText="Nome público." />
    <SUINumericField T="int" Label="Tentativas" @bind-Value="Count" Min="1" Max="10" />
</SUIFormGrid>
<SUIStack Row Wrap>
    <SUIButton OnClick="Notify">Salvar alterações</SUIButton>
    <SUIButton VariantValue="SUIVariant.Outlined" OnClick="ResetPreferences">Cancelar</SUIButton>
    <SUIButton Disabled>Indisponível</SUIButton>
</SUIStack>
@code {
    private void ResetPreferences() { Count = 3; Reset(); }
}
