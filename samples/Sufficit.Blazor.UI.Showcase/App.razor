@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<SUIThemeProvider Theme="@_preference.Build()">
    @if (!IsPreview)
    {
    <a class="skip-link" href="#main">Ir para o conteúdo</a>
    <header class="site-header">
        <a class="brand" href="."><span class="brand-mark">SUI</span><span>Sufficit.Blazor.UI</span></a>
        <div class="header-actions">
            <SUISelect T="string" Label="Tema" Class="theme-select" Value="@_preference.Mode" ValueChanged="ChangeMode">
                <SUISelectItem Value='@("system")'>Sistema</SUISelectItem>
                <SUISelectItem Value='@("light")'>Claro</SUISelectItem>
                <SUISelectItem Value='@("dark")'>Escuro</SUISelectItem>
            </SUISelect>
            <a href="https://github.com/sufficit/sufficit-blazor-ui">GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </header>
    }
    <CascadingValue Value="_preference">
        <CascadingValue Value="_changeTheme">
            @if (IsPreview) { <main id="main" class="theme-frame"><ThemePreview /></main> }
            else {
            <Router AppAssembly="typeof(App).Assembly">
                <Found Context="route"><RouteView RouteData="route" /></Found>
                <NotFound><main id="main" class="document"><h1>Página não encontrada</h1><a href=".">Voltar ao catálogo</a></main></NotFound>
            </Router>
            }
        </CascadingValue>
    </CascadingValue>
    <SUIDialogHost />
    <SUISnackbarHost />
</SUIThemeProvider>

@code {
    private bool IsPreview => Navigation.Uri.Contains("?preview=", StringComparison.Ordinal);
    private ThemePreference _preference = new("system", "amber", "comfortable", false);
    private DotNetObjectReference<App>? _reference;
    private Func<ThemePreference, Task> _changeTheme = default!;
    protected override void OnInitialized() => _changeTheme = SetTheme;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        _preference = await JS.InvokeAsync<ThemePreference>("suiShowcase.connect", _reference);
        StateHasChanged();
    }
    private Task ChangeMode(string? mode) => SetTheme(_preference with { Mode = mode ?? "system" });
    private async Task SetTheme(ThemePreference preference)
    {
        _preference = await JS.InvokeAsync<ThemePreference>("suiShowcase.set", preference);
        StateHasChanged();
    }
    [JSInvokable] public Task SystemThemeChanged(ThemePreference preference) => InvokeAsync(() => { _preference = preference; StateHasChanged(); });
    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("suiShowcase.disconnect");
        _reference?.Dispose();
    }
}
