<h1>@Entry.Name</h1>
<p class="lead">@Entry.Family · Experimente o componente e use o exemplo na sua aplicação.</p>
<section aria-label="Demonstração" class="component-preview">
    <div class="preview-label"><span>Demonstração interativa</span><a href="?view=themes">Personalizar tema</a></div>
    <div class="preview-content"><DynamicComponent Type="DemoCatalog.ExampleType(Entry.Name)" /></div>
</section>
<ComponentPlayground Name="@Entry.Name" />
<details class="source-panel component-source" open>
    <summary>Código Razor <span>Exemplo completo</span></summary>
    <div class="source-actions"><SUICopyToClipboard Text="@Entry.Source" Title="Exemplo Razor"><SUIButton VariantValue="SUIVariant.Text">Copiar código</SUIButton></SUICopyToClipboard></div>
    <pre tabindex="0"><code>@Entry.Source</code></pre>
</details>
<section class="api-section">
    <h2>Parâmetros e eventos</h2>
    <p>Contrato extraído do código-fonte. Parâmetros obsoletos são mantidos para compatibilidade.</p>
    @if (Entry.Parameters.Count == 0) { <p>Este componente não expõe parâmetros próprios.</p> }
    else
    {
        <div class="api-scroll" tabindex="0" role="region" aria-label="Parâmetros do componente"><table><thead><tr><th scope="col">Parâmetro</th><th scope="col">Tipo</th><th scope="col">Padrão</th><th scope="col">Uso</th></tr></thead><tbody>
            @foreach (var parameter in Entry.Parameters)
            {
                <tr><th scope="row"><code>@parameter.Name</code>@if (parameter.Required) { <small>Obrigatório</small> }@if (parameter.Deprecated) { <small>Obsoleto</small> }</th><td><code>@parameter.Type</code></td><td><code>@parameter.Default</code></td><td>@(string.IsNullOrWhiteSpace(parameter.Description) ? "Sem descrição no código-fonte." : parameter.Description)</td></tr>
            }
        </tbody></table></div>
    }
</section>
@code { [Parameter, EditorRequired] public DemoEntry Entry { get; set; } = default!; }
