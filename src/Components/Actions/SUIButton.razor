@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using Sufficit.Blazor.UI.Utilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

@{
    bool isAnchor = !string.IsNullOrWhiteSpace(Href);
    var cls = SUIClassBuilder.Default("sui-btn")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveVariant)}")
        .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(EffectiveColor)}")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveSize)}")
        .AddClass("sui-btn--full-width", FullWidth)
        .AddClass("sui-btn--loading", ShowLoading)
        .AddClass(Class)
        .Build();
    bool isDisabled = Disabled || ShowLoading;
}

@if (isAnchor)
{
    <a @ref="_elementReference" class="@cls" style="@Style" href="@Href" target="@Target" rel="@GetRel()"
       aria-busy="@(ShowLoading ? "true" : null)" aria-disabled="@isDisabled" @onclick="OnClickHandler" @onclick:preventDefault="@isDisabled"
       @attributes="AdditionalAttributes">
        @RenderBody()
    </a>
}
else
{
    <button @ref="_elementReference" type="@SUIClassBuilder.Slug(EffectiveButtonType)" class="@cls" style="@Style"
            aria-busy="@(ShowLoading ? "true" : null)" disabled="@isDisabled" @onclick="OnClickHandler" @attributes="AdditionalAttributes">
        @RenderBody()
    </button>
}

@code {
    // The SUI button manages its own loading state during click handling.
    protected bool IsLoading;
    private ElementReference _elementReference;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUIColor? IconColorValue { get; set; }
    [Parameter] public SUIVariant? VariantValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }
    [Parameter] public SUISize? IconSizeValue { get; set; }
    [Parameter] public SUIButtonType? ButtonTypeValue { get; set; }

    /// <summary>Leading icon: an <see cref="SUIIcon"/> name (e.g. "arrow-left") or <see cref="SUIIcons"/> SVG markup.</summary>
    [Parameter]
    public string? StartIcon { get; set; }

    /// <summary>Trailing icon: an <see cref="SUIIcon"/> name or <see cref="SUIIcons"/> SVG markup.</summary>
    [Parameter]
    public string? EndIcon { get; set; }

    /// <summary>Shows the loading spinner and disables the button, whatever the click state.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// Milliseconds an asynchronous <c>OnClick</c> must still be running before
    /// the automatic spinner appears (default 300). Synchronous and short
    /// handlers never flash a spinner; a negative value disables the automatic
    /// spinner entirely (use <see cref="Loading"/> to drive it).
    /// </summary>
    [Parameter]
    public int LoadingDelay { get; set; } = SUIClickLoading.DefaultDelay;

    [Parameter]
    public string? IconClass { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    /// <summary>Legacy alias for <see cref="SUIComponentBase.AdditionalAttributes"/>.</summary>
    [Parameter, Obsolete("Use AdditionalAttributes instead; this alias will be removed in the next breaking release.")]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    protected override void OnParametersSet()
    {
#pragma warning disable CS0618 // deliberate bridge for the obsolete parameter
        MergeLegacyAttributes(UserAttributes);
#pragma warning restore CS0618
    }

    protected string GetRel()
    {
        if (!string.IsNullOrWhiteSpace(Rel))
            return Rel;
        // External/new-tab anchors get noopener by default.
        if (!string.IsNullOrWhiteSpace(Target) && Target != "_self")
            return "noopener noreferrer";
        return string.Empty;
    }

    protected string GetIconClass()
        => SUIClassBuilder.Default("sui-icon sui-icon--small sui-btn__icon")
            .AddClass(IconClass)
            .Build();

    protected async Task OnClickHandler(MouseEventArgs ev)
    {
        // Anchors keep their native navigation unless the component is disabled.
        // The previous unconditional preventDefault made every Href-only button inert.
        if (Disabled || ShowLoading || _running)
            return;

        if (OnClick.HasDelegate)
        {
            _running = true;
            try
            {
                await SUIClickLoading.RunAsync(OnClick.InvokeAsync(ev), LoadingDelay,
                    busy => { IsLoading = busy; return InvokeAsync(StateHasChanged); });
            }
            finally
            {
                _running = false;
            }
        }
    }

    private bool _running;
    private bool ShowLoading => Loading || IsLoading;

    /// <summary>Moves keyboard focus to the button or anchor.</summary>
    public ValueTask FocusAsync()
        => _elementReference.FocusAsync();

    /// <summary>Moves keyboard focus to the button, optionally without scrolling it into view.</summary>
    public ValueTask FocusAsync(bool preventScroll)
        => _elementReference.FocusAsync(preventScroll);

    private RenderFragment RenderBody() => __builder =>
    {
        var iconSizeClass = $"sui-icon--{SUIClassBuilder.Slug(EffectiveIconSize)}";
        var iconColorSlug = SUIClassBuilder.Slug(EffectiveIconColor);

        if (ShowLoading)
        {
            <span class="sui-overlay sui-overlay--light">
                <span class="sui-progress-circular sui-progress-circular--sm sui-color-@iconColorSlug">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@SUIIconMarkup.Render(SUIIcons.ProgressCircular)</svg>
                </span>
            </span>
        }
        <span class="sui-btn__label">
            @if (!string.IsNullOrWhiteSpace(StartIcon))
            {
                <span class="sui-icon @iconSizeClass sui-btn__icon sui-color-@iconColorSlug">
                    @SUIClickLoading.Glyph(StartIcon)
                </span>
            }
            @ChildContent
            @if (!string.IsNullOrWhiteSpace(EndIcon))
            {
                <span class="sui-icon @iconSizeClass sui-btn__icon sui-color-@iconColorSlug">
                    @SUIClickLoading.Glyph(EndIcon)
                </span>
            }
        </span>
    };

    public void Dispose() { }

    private SUIColor EffectiveColor => ColorValue ?? SUIColor.Primary;
    private SUIColor EffectiveIconColor => IconColorValue ?? SUIColor.Inherit;
    private SUIVariant EffectiveVariant => VariantValue ?? SUIVariant.Filled;
    private SUISize EffectiveSize => SizeValue ?? SUISize.Medium;
    private SUISize EffectiveIconSize => IconSizeValue ?? SUISize.Small;
    private SUIButtonType EffectiveButtonType => ButtonTypeValue ?? SUIButtonType.Button;
}
