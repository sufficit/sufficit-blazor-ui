@namespace Sufficit.Blazor.UI.Components
@using Sufficit.Blazor.UI.Utilities
@implements IDisposable

@{
    bool isAnchor = !string.IsNullOrWhiteSpace(Href);
    // Only intercept the click when an OnClick handler is bound; otherwise let
    // the browser follow the href normally (so Href-only anchors actually
    // navigate instead of being silently swallowed by preventDefault).
    bool preventDefault = OnClick.HasDelegate;
    var cls = SUIClassBuilder.Default("sui-btn sui-btn--icon")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveVariant)}")
        .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(EffectiveColor)}")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveSize)}")
        .AddClass($"sui-btn--edge-{SUIClassBuilder.Slug(EffectiveEdge)}")
        .AddClass("sui-btn--full-width", FullWidth)
        .AddClass("sui-btn--loading", IsLoading)
        .AddClass(Class)
        .Build();
    bool isDisabled = Disabled || IsLoading;
}

@if (isAnchor)
{
    <a class="@cls" style="@Style" href="@Href" target="@Target" rel="@GetRel()"
       aria-label="@Title" aria-disabled="@isDisabled" @onclick="OnClickHandler" @onclick:preventDefault="@preventDefault"
       @attributes="UserAttributes">
        @RenderBody()
    </a>
}
else
{
    <button type="@SUIClassBuilder.Slug(EffectiveButtonType)" class="@cls" style="@Style"
            aria-label="@Title" disabled="@isDisabled" @onclick="OnClickHandler"
            @attributes="UserAttributes">
        @RenderBody()
    </button>
}

@code {
    protected bool IsLoading;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter, Obsolete("Use ColorValue. The object bridge will be removed in v2.0.0.")]
    public object Color { get; set; } = SUIColor.Default;

    [Parameter, Obsolete("Use SizeValue. The object bridge will be removed in v2.0.0.")]
    public object Size { get; set; } = SUISize.Medium;

    [Parameter, Obsolete("Use VariantValue. The object bridge will be removed in v2.0.0.")]
    public object Variant { get; set; } = SUIVariant.Text;

    [Parameter, Obsolete("Use EdgeValue. The object bridge will be removed in v2.0.0.")]
    public object Edge { get; set; } = SUIEdge.False;

    [Parameter, Obsolete("Use ButtonTypeValue. The object bridge will be removed in v2.0.0.")]
    public object ButtonType { get; set; } = SUIButtonType.Button;

    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }
    [Parameter] public SUIVariant? VariantValue { get; set; }
    [Parameter] public SUIEdge? EdgeValue { get; set; }
    [Parameter] public SUIButtonType? ButtonTypeValue { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    protected string GetRel()
    {
        if (!string.IsNullOrWhiteSpace(Rel))
            return Rel;
        if (!string.IsNullOrWhiteSpace(Target) && Target != "_self")
            return "noopener noreferrer";
        return string.Empty;
    }

    protected async Task OnClickHandler(MouseEventArgs ev)
    {
        if (Disabled)
            return;

        if (OnClick.HasDelegate)
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);
            try
            {
                await OnClick.InvokeAsync(ev);
            }
            finally
            {
                IsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private RenderFragment RenderBody() => __builder =>
    {
        if (IsLoading)
        {
            <span class="sui-overlay sui-overlay--light">
                <span class="sui-progress-circular sui-progress-circular--sm sui-color-@SUIClassBuilder.Slug(EffectiveColor)">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)SUIIcons.ProgressCircular)</svg>
                </span>
            </span>
        }
        if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sui-icon sui-icon--@SUIClassBuilder.Slug(EffectiveSize)">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)Icon)</svg>
            </span>
        }
        else
        {
            <span class="sui-text sui-text--body2 sui-color-inherit">@ChildContent</span>
        }
    };

    public void Dispose() { }

#pragma warning disable CS0618
    private object EffectiveColor => ColorValue ?? Color;
    private object EffectiveSize => SizeValue ?? Size;
    private object EffectiveVariant => VariantValue ?? Variant;
    private object EffectiveEdge => EdgeValue ?? Edge;
    private object EffectiveButtonType => ButtonTypeValue ?? ButtonType;
#pragma warning restore CS0618
}
