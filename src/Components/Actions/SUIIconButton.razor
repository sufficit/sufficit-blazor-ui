@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using Sufficit.Blazor.UI.Utilities
@implements IDisposable

@{
    bool isAnchor = !string.IsNullOrWhiteSpace(Href);
    // Only intercept the click when an OnClick handler is bound; otherwise let
    // the browser follow the href normally (so Href-only anchors actually
    // navigate instead of being silently swallowed by preventDefault).
    bool preventDefault = OnClick.HasDelegate;
    var cls = SUIClassBuilder.Default("sui-btn sui-btn--icon")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveVariant)}")
        .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(EffectiveColor)}")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveSize)}")
        .AddClass($"sui-btn--edge-{SUIClassBuilder.Slug(EffectiveEdge)}")
        .AddClass("sui-btn--full-width", FullWidth)
        .AddClass("sui-btn--loading", ShowLoading)
        .AddClass(Class)
        .Build();
    bool isDisabled = Disabled || ShowLoading;
}

@if (isAnchor)
{
    <a @ref="_elementReference" class="@cls" style="@Style" href="@Href" target="@Target" rel="@GetRel()"
       aria-label="@Title" aria-disabled="@isDisabled" @onclick="OnClickHandler" @onclick:preventDefault="@preventDefault"
       @attributes="AdditionalAttributes">
        @RenderBody()
    </a>
}
else
{
    <button @ref="_elementReference" type="@SUIClassBuilder.Slug(EffectiveButtonType)" class="@cls" style="@Style"
            aria-label="@Title" disabled="@isDisabled" @onclick="OnClickHandler"
            @attributes="AdditionalAttributes">
        @RenderBody()
    </button>
}

@code {
    protected bool IsLoading;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>SUI icon name or inline SVG drawn by the button. Decorative: it carries no accessible name.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Accessible name, rendered as <c>aria-label</c>. An icon-only button has
    /// no text for assistive technology to read, so it MUST receive a name from
    /// one of: this parameter (preferred, e.g. <c>Title="Excluir pedido"</c>),
    /// an explicit <c>aria-label</c>/<c>aria-labelledby</c> attribute, or visible
    /// text in <see cref="ChildContent"/>. It stays nullable because the last two
    /// are valid sources the component cannot see; leaving all three empty yields
    /// an unnamed button (WCAG 2.2 SC 4.1.2), which axe reports in the catalog
    /// but nothing catches in a consumer app.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }
    [Parameter] public SUIVariant? VariantValue { get; set; }
    [Parameter] public SUIEdge? EdgeValue { get; set; }
    [Parameter] public SUIButtonType? ButtonTypeValue { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    /// <summary>Legacy alias for <see cref="SUIComponentBase.AdditionalAttributes"/>.</summary>
    [Parameter, Obsolete("Use AdditionalAttributes instead; this alias will be removed in the next breaking release.")]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    protected override void OnParametersSet()
    {
#pragma warning disable CS0618 // deliberate bridge for the obsolete parameter
        MergeLegacyAttributes(UserAttributes);
#pragma warning restore CS0618
    }

    protected string GetRel()
    {
        if (!string.IsNullOrWhiteSpace(Rel))
            return Rel;
        if (!string.IsNullOrWhiteSpace(Target) && Target != "_self")
            return "noopener noreferrer";
        return string.Empty;
    }

    protected async Task OnClickHandler(MouseEventArgs ev)
    {
        if (Disabled || ShowLoading || _running)
            return;

        if (OnClick.HasDelegate)
        {
            _running = true;
            try
            {
                await SUIClickLoading.RunAsync(OnClick.InvokeAsync(ev), AutoLoading ? LoadingDelay : -1,
                    busy => { IsLoading = busy; return InvokeAsync(StateHasChanged); });
            }
            finally
            {
                _running = false;
            }
        }
    }

    private ElementReference _elementReference;
    private bool _running;
    private bool ShowLoading => Loading || IsLoading;

    /// <summary>Shows the loading spinner and disables the button, whatever the click state.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// Milliseconds an asynchronous <c>OnClick</c> must still be running before
    /// the automatic spinner appears (default 300). Synchronous and short
    /// handlers never flash a spinner; a negative value disables it entirely.
    /// </summary>
    [Parameter]
    public int LoadingDelay { get; set; } = SUIClickLoading.DefaultDelay;

    /// <summary>
    /// Whether a long-running <c>OnClick</c> shows the spinner on its own
    /// (default true). Set false for handlers that await a user interaction,
    /// such as a dialog result, where a spinner would misreport the wait.
    /// Re-entry stays blocked while the handler runs either way.
    /// </summary>
    [Parameter]
    public bool AutoLoading { get; set; } = true;

    /// <summary>
    /// Moves keyboard focus to the button or anchor, e.g. so a toggle pair can
    /// hand focus to its counterpart when it disappears.
    /// </summary>
    public ValueTask FocusAsync(bool preventScroll = false)
        => _elementReference.FocusAsync(preventScroll);

    private RenderFragment RenderBody() => __builder =>
    {
        if (ShowLoading)
        {
            <span class="sui-overlay sui-overlay--light">
                <span class="sui-progress-circular sui-progress-circular--sm sui-color-@SUIClassBuilder.Slug(EffectiveColor)">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@SUIIconMarkup.Render(SUIIcons.ProgressCircular)</svg>
                </span>
            </span>
        }
        if (!string.IsNullOrEmpty(Icon))
        {
            <span class="sui-icon sui-icon--@SUIClassBuilder.Slug(EffectiveSize)">
                @SUIClickLoading.Glyph(Icon)
            </span>
        }
        else
        {
            <span class="sui-text sui-text--body2 sui-color-inherit">@ChildContent</span>
        }
    };

    public void Dispose() { }

    private SUIColor EffectiveColor => ColorValue ?? SUIColor.Default;
    private SUISize EffectiveSize => SizeValue ?? SUISize.Medium;
    private SUIVariant EffectiveVariant => VariantValue ?? SUIVariant.Text;
    private SUIEdge EffectiveEdge => EdgeValue ?? SUIEdge.False;
    private SUIButtonType EffectiveButtonType => ButtonTypeValue ?? SUIButtonType.Button;
}
