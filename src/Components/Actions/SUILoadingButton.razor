@* Loading Button — async operation pattern. *@
@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using Sufficit.Blazor.UI.Utilities
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@{
    bool isAnchor = !string.IsNullOrWhiteSpace(Href);
    var cls = SUIClassBuilder.Default("sui-btn")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveVariant)}")
        .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(EffectiveColor)}")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveSize)}")
        .AddClass("sui-btn--full-width", FullWidth)
        .AddClass("sui-btn--loading", IsLoading)
        .AddClass(Class)
        .Build();
    string spinClass = SpinDirection == SUISpinDirection.CounterClockwise
        ? "sui-progress-circular sui-progress-circular--reverse"
        : "sui-progress-circular";
}

@if (isAnchor)
{
    <a @ref="_element" class="@cls" style="@Style" href="@Href" target="@Target"
       aria-disabled="@IsAriaDisabled" aria-busy="@(IsLoading ? "true" : null)"
       data-sui-instant-busy="@(InstantFeedback ? "" : null)"
       @onclick="HandleClickAsync" @onclick:preventDefault="@IsAriaDisabled"
       @attributes="AdditionalAttributes">
        @Body(spinClass)
    </a>
}
else
{
    <button @ref="_element" type="@SUIClassBuilder.Slug(EffectiveButtonType)" class="@cls" style="@Style"
            disabled="@(Disabled || IsLoading)" aria-disabled="@IsAriaDisabled"
            aria-busy="@(IsLoading ? "true" : null)"
            data-sui-instant-busy="@(InstantFeedback ? "" : null)"
            @onclick="HandleClickAsync" @attributes="AdditionalAttributes">
        @Body(spinClass)
    </button>
}


@code {
    private RenderFragment Body(string spinClass) => @<text>
        @if (IsLoading)
        {
            <span class="sui-overlay sui-overlay--light" aria-hidden="true"><span class="@spinClass">@SpinnerSvg</span></span>
        }
        <span class="sui-btn__label" style="@(IsLoading ? "opacity:0" : null)">
            @if (!string.IsNullOrEmpty(StartIcon))
            {
                <span class="sui-icon sui-icon--small sui-btn__icon">@SUIClickLoading.Glyph(StartIcon)</span>
            }
            @ChildContent
            @if (!string.IsNullOrEmpty(EndIcon))
            {
                <span class="sui-icon sui-icon--small sui-btn__icon">@SUIClickLoading.Glyph(EndIcon)</span>
            }
        </span>
    </text>;

    private bool IsAriaDisabled => Disabled || IsLoading;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Whether the button reacts to the press before the server answers.
    /// </summary>
    /// <remarks>
    /// <see cref="IsLoading"/> comes from the parent, so it can only arrive
    /// after a round trip — long enough on a slow link to read as a click that
    /// did nothing. With this on (the default), a script marks the button in
    /// the capture phase of the click and the spinner takes over when
    /// <see cref="IsLoading"/> arrives. Turn it off for a button whose click
    /// legitimately does nothing visible.
    /// </remarks>
    [Parameter]
    public bool InstantFeedback { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter] public SUIVariant? VariantValue { get; set; }
    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUIButtonType? ButtonTypeValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Leading icon: an <see cref="SUIIcon"/> name (e.g. "key") or <see cref="SUIIcons"/> SVG markup.</summary>
    [Parameter]
    public string? StartIcon { get; set; }

    /// <summary>Trailing icon: an <see cref="SUIIcon"/> name or <see cref="SUIIcons"/> SVG markup.</summary>
    [Parameter]
    public string? EndIcon { get; set; }

    /// <summary>
    /// Custom loading indicator: inner SVG content (paths). Null = the default
    /// 3/4 arc, a stroke-based glyph with no arrowhead so the rotation always
    /// reads as forward motion.
    /// </summary>
    [Parameter]
    public string? LoadingIcon { get; set; }

    /// <summary>Rotation direction of the loading spinner. Default clockwise.</summary>
    [Parameter]
    public SUISpinDirection SpinDirection { get; set; } = SUISpinDirection.Clockwise;

    /// <summary>
    /// The loading svg. A custom <see cref="LoadingIcon"/> renders fill-based
    /// like the other icons; the default arc renders stroke-based with a
    /// rounded cap — the same artwork family as the determinate progress ring,
    /// so indeterminate and determinate no longer look like strangers.
    /// </summary>
    /// <remarks>
    /// A custom icon is validated before it is interpolated. This one built the
    /// whole element by string concatenation, so an unchecked LoadingIcon could
    /// close the svg and continue with markup of its own choosing rather than
    /// merely drawing inside it.
    /// </remarks>
    private MarkupString SpinnerSvg
        => LoadingIcon is { Length: > 0 } custom && SUIIconMarkup.IsSafe(custom)
            ? (MarkupString)$"<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">{custom}</svg>"
            : (MarkupString)"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 2.75A9.25 9.25 0 1 0 21.25 12\"/></svg>";

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    /// <summary>Legacy alias for <see cref="SUIComponentBase.AdditionalAttributes"/>.</summary>
    [Parameter, Obsolete("Use AdditionalAttributes instead; this alias will be removed in the next breaking release.")]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    protected override void OnParametersSet()
    {
#pragma warning disable CS0618 // deliberate bridge for the obsolete parameter
        MergeLegacyAttributes(UserAttributes);
#pragma warning restore CS0618
        // A submit press has no handler of its own: the form's handler answers
        // it, and that answer reaches this button as a parent render.
        if (_awaitingParent)
        {
            _awaitingParent = false;
            _releasePending = true;
        }
    }

    private SUIVariant EffectiveVariant => VariantValue ?? SUIVariant.Filled;
    private SUIColor EffectiveColor => ColorValue ?? SUIColor.Primary;
    private SUIButtonType EffectiveButtonType => ButtonTypeValue ?? SUIButtonType.Button;
    private SUISize EffectiveSize => SizeValue ?? SUISize.Medium;
}
