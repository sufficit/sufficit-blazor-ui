@* Loading Button — async operation pattern. *@
@namespace Sufficit.Blazor.UI.Components
@using Sufficit.Blazor.UI.Utilities

@{
    bool isAnchor = !string.IsNullOrWhiteSpace(Href);
    var cls = SUIClassBuilder.Default("sui-btn")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveVariant)}")
        .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(EffectiveColor)}")
        .AddClass($"sui-btn--{SUIClassBuilder.Slug(EffectiveSize)}")
        .AddClass("sui-btn--full-width", FullWidth)
        .AddClass("sui-btn--loading", IsLoading)
        .AddClass(Class)
        .Build();
    string spinClass = SpinDirection == SUISpinDirection.CounterClockwise
        ? "sui-progress-circular sui-progress-circular--reverse"
        : "sui-progress-circular";
}

@if (isAnchor)
{
    <a class="@cls" style="@Style" href="@Href" target="@Target"
       aria-disabled="@IsAriaDisabled" @onclick="HandleClickAsync" @onclick:preventDefault
       @attributes="UserAttributes">
        @if (IsLoading)
        {
            <span class="sui-overlay sui-overlay--light">
                <span class="@spinClass">@SpinnerSvg</span>
            </span>
            <span class="sui-btn__label" style="opacity:0">@ChildContent</span>
        }
        else
        {
            <span class="sui-btn__label">
                @if (!string.IsNullOrEmpty(StartIcon))
                {
                    <span class="sui-icon sui-icon--sm sui-btn__icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)StartIcon)</svg></span>
                }
                @ChildContent
                @if (!string.IsNullOrEmpty(EndIcon))
                {
                    <span class="sui-icon sui-icon--sm sui-btn__icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)EndIcon)</svg></span>
                }
            </span>
        }
    </a>
}
else
{
    <button type="@SUIClassBuilder.Slug(EffectiveButtonType)" class="@cls" style="@Style"
            disabled="@(Disabled || IsLoading)" aria-disabled="@IsAriaDisabled"
            @onclick="HandleClickAsync" @attributes="UserAttributes">
        @if (IsLoading)
        {
            <span class="sui-overlay sui-overlay--light">
                <span class="@spinClass">@SpinnerSvg</span>
            </span>
            <span class="sui-btn__label" style="opacity:0">@ChildContent</span>
        }
        else
        {
            <span class="sui-btn__label">
                @if (!string.IsNullOrEmpty(StartIcon))
                {
                    <span class="sui-icon sui-icon--sm sui-btn__icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)StartIcon)</svg></span>
                }
                @ChildContent
                @if (!string.IsNullOrEmpty(EndIcon))
                {
                    <span class="sui-icon sui-icon--sm sui-btn__icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)EndIcon)</svg></span>
                }
            </span>
        }
    </button>
}

@code {
    private bool IsAriaDisabled => Disabled || IsLoading;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter, Obsolete("Use VariantValue. The object bridge will be removed in v2.0.0.")]
    public object Variant { get; set; } = SUIVariant.Filled;

    [Parameter, Obsolete("Use ColorValue. The object bridge will be removed in v2.0.0.")]
    public object Color { get; set; } = SUIColor.Primary;

    [Parameter, Obsolete("Use ButtonTypeValue. The object bridge will be removed in v2.0.0.")]
    public object ButtonType { get; set; } = SUIButtonType.Button;

    [Parameter, Obsolete("Use SizeValue. The object bridge will be removed in v2.0.0.")]
    public object Size { get; set; } = SUISize.Medium;

    [Parameter] public SUIVariant? VariantValue { get; set; }
    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUIButtonType? ButtonTypeValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public string? StartIcon { get; set; }

    [Parameter]
    public string? EndIcon { get; set; }

    /// <summary>
    /// Custom loading indicator: inner SVG content (paths). Null = the default
    /// 3/4 arc, a stroke-based glyph with no arrowhead so the rotation always
    /// reads as forward motion.
    /// </summary>
    [Parameter]
    public string? LoadingIcon { get; set; }

    /// <summary>Rotation direction of the loading spinner. Default clockwise.</summary>
    [Parameter]
    public SUISpinDirection SpinDirection { get; set; } = SUISpinDirection.Clockwise;

    /// <summary>
    /// The loading svg. A custom <see cref="LoadingIcon"/> renders fill-based
    /// like the other icons; the default arc renders stroke-based with a
    /// rounded cap — the same artwork family as the determinate progress ring,
    /// so indeterminate and determinate no longer look like strangers.
    /// </summary>
    private MarkupString SpinnerSvg => LoadingIcon is { Length: > 0 } custom
        ? (MarkupString)$"<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">{custom}</svg>"
        : (MarkupString)"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 2.75A9.25 9.25 0 1 0 21.25 12\"/></svg>";

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    private Task HandleClickAsync(MouseEventArgs args)
        => (IsLoading || Disabled || !OnClick.HasDelegate)
            ? Task.CompletedTask
            : OnClick.InvokeAsync(args);

#pragma warning disable CS0618
    private object EffectiveVariant => VariantValue ?? Variant;
    private object EffectiveColor => ColorValue ?? Color;
    private object EffectiveButtonType => ButtonTypeValue ?? ButtonType;
    private object EffectiveSize => SizeValue ?? Size;
#pragma warning restore CS0618
}
