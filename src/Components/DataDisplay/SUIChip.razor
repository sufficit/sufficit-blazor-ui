@namespace Sufficit.Blazor.UI.Components

<span class="@Classname" @attributes="AdditionalAttributes">
    @if (OnClick.HasDelegate)
    {
        <button type="button"
                class="sui-chip__action"
                aria-label="@ActionLabel"
                title="@ActionLabel"
                @onclick="ClickAsync">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <span class="sui-chip__leading" aria-hidden="true">
                    <SUIIcon Name="@Icon" Size="@LeadingIconSize" />
                </span>
            }
            <span class="sui-chip__label">@ChildContent</span>
        </button>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="sui-chip__leading" aria-hidden="true">
                <SUIIcon Name="@Icon" Size="@LeadingIconSize" />
            </span>
        }
        <span class="sui-chip__label">@ChildContent</span>
    }
    @if (OnRemove.HasDelegate)
    {
        <button type="button"
                class="sui-chip__remove"
                aria-label="@RemoveLabel"
                title="@RemoveLabel"
                @onclick="RemoveAsync"
                @onclick:stopPropagation="true">
            <SUIIcon Name="x" Size="@RemoveIconSize" />
        </button>
    }
</span>

@code {
    /// <summary>Chip color. Lowercase string: "default", "primary", "secondary",
    /// "success", "warning", "error", "info". Default "default".</summary>
    [Parameter, Obsolete("Use ColorValue. The object bridge will be removed in v2.0.0.")]
    public object? Color { get; set; } = SUIColor.Default;

    /// <summary>Size: "small" or "medium". Default "medium".</summary>
    [Parameter, Obsolete("Use SizeValue. The object bridge will be removed in v2.0.0.")]
    public object? Size { get; set; }

    /// <summary>Variant: "filled", "outlined", "text". Default "filled".</summary>
    [Parameter, Obsolete("Use VariantValue. The object bridge will be removed in v2.0.0.")]
    public object? Variant { get; set; } = SUIVariant.Filled;

    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }
    [Parameter] public SUIVariant? VariantValue { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional primary action for interactive chips.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Accessible label and tooltip for the primary action.</summary>
    [Parameter]
    public string ActionLabel { get; set; } = "Selecionar";

    /// <summary>Optional action that renders a compact, accessible remove control.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Accessible label and tooltip for the remove action.</summary>
    [Parameter]
    public string RemoveLabel { get; set; } = "Remover";

    /// <summary>
    /// Additional HTML attributes forwarded to the root element, including
    /// accessibility attributes such as <c>aria-live</c> and <c>role</c>.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string Classname
        => SUIClassBuilder.Default("sui-chip")
            .AddClass($"sui-chip--{SUIClassBuilder.Slug(EffectiveColor)}")
            .AddClass($"sui-chip--{SUIClassBuilder.Slug(EffectiveSize)}", EffectiveSize is not null)
            .AddClass($"sui-chip--{SUIClassBuilder.Slug(EffectiveVariant)}")
            .AddClass("sui-chip--actionable", OnClick.HasDelegate)
            .AddClass("sui-chip--removable", OnRemove.HasDelegate)
            .AddClass(Class)
            .Build();

    private bool IsSmall => SUIClassBuilder.Slug(EffectiveSize) == "small";
    private int LeadingIconSize => IsSmall ? 12 : 14;
    private int RemoveIconSize => IsSmall ? 10 : 12;

    private Task ClickAsync() => OnClick.InvokeAsync();
    private Task RemoveAsync() => OnRemove.InvokeAsync();

#pragma warning disable CS0618
    private object EffectiveColor => ColorValue ?? Color ?? SUIColor.Default;
    private object? EffectiveSize => SizeValue ?? Size;
    private object EffectiveVariant => VariantValue ?? Variant ?? SUIVariant.Filled;
#pragma warning restore CS0618
}
