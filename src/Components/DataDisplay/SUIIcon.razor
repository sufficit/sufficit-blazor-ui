@namespace Sufficit.Blazor.UI.Components

<svg class="@CssClass"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.9"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /> break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /> break;
        case "key":
            <circle cx="7.5" cy="15.5" r="4.5" /><path d="m10.7 12.3 8-8M15 8l2 2M17.5 5.5l2 2" /> break;
        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" /> break;
        case "scope":
            <circle cx="7" cy="7" r="3" /><circle cx="17" cy="17" r="3" /><path d="M9.2 9.2 14.8 14.8M14 7h3a2 2 0 0 1 2 2v3M10 17H7a2 2 0 0 1-2-2v-3" /> break;
        case "palette":
            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" stroke="none" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" stroke="none" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" stroke="none" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" stroke="none" /><path d="M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.6-1.4-.3-.4-.5-.9-.5-1.4 0-1.1.9-2 2-2H17a5 5 0 0 0 5-5C22 5.7 17.5 2 12 2Z" /> break;
        case "volume":
            <path d="m11 5-5 4H3v6h3l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" /> break;
        case "phone":
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" /> break;
        case "inbox":
            <path d="M4 4h16v16H4z" /><path d="m4 14 4-6h8l4 6h-4l-2 3h-4l-2-3H4Z" /> break;
        case "workflow":
            <rect x="3" y="3" width="6" height="6" rx="1.5" /><rect x="15" y="15" width="6" height="6" rx="1.5" /><path d="M9 6h4a4 4 0 0 1 4 4v5M15 18h-4a4 4 0 0 1-4-4V9" /> break;
        case "audit":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6M8 13h8M8 17h5" /> break;
        case "chart":
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /> break;
        case "settings":
            <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.6v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "x": <path d="m18 6-12 12M6 6l12 12" /> break;
        case "bell": <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /> break;
        case "eye-off": <path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 4.2A10.8 10.8 0 0 1 12 4c5.5 0 9 6 9 8a12.7 12.7 0 0 1-2.1 3.4M6.6 6.6C4.4 8.1 3 10.6 3 12c0 2 3.5 8 9 8a10.8 10.8 0 0 0 3.1-.5" /> break;
        case "arrow-right": <path d="M5 12h14M13 6l6 6-6 6" /> break;
        case "arrow-left": <path d="M19 12H5M11 18l-6-6 6-6" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "external": <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /> break;
        case "alert": <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" /> break;
        case "check": <path d="m20 6-11 11-5-5" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "database": <ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" /> break;
        case "lock": <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /> break;
        case "code": <path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14" /> break;
        case "browser": <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01" /> break;
        case "device": <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M10 5h4M11 18h2" /> break;
        case "server": <rect x="3" y="3" width="18" height="7" rx="2" /><rect x="3" y="14" width="18" height="7" rx="2" /><path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6" /> break;
        case "terminal": <rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3M13 15h4" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /> break;
        case "calendar": <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /> break;
        case "chevron-left": <path d="m15 18-6-6 6-6" /> break;
        case "chevron-right": <path d="m9 18 6-6-6-6" /> break;
        case "chevron-down": <path d="m6 9 6 6 6-6" /> break;
        case "refresh": <path d="M20 6v5h-5" /><path d="M4 18v-5h5" /><path d="M18.4 9a7 7 0 0 0-11.8-2.6L4 9M6 15a7 7 0 0 0 11.8 2.6L20 15" /> break;
        case "trash": <path d="M3 6h18M8 6V4h8v2M19 6l-1 15H6L5 6" /><path d="M10 11v5M14 11v5" /> break;
        case "edit": <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" /> break;
        case "pix": <path fill="currentColor" stroke="none" d="m12 3.4 3.9 3.9a2.4 2.4 0 0 0 1.7.7H19l2 2-2 2h-1.4a2.4 2.4 0 0 0-1.7.7L12 16.6l-3.9-3.9a2.4 2.4 0 0 0-1.7-.7H5l-2-2 2-2h1.4a2.4 2.4 0 0 0 1.7-.7L12 3.4Zm0 2.8L9.5 8.7A4.4 4.4 0 0 1 6.4 10a4.4 4.4 0 0 1 3.1 1.3l2.5 2.5 2.5-2.5a4.4 4.4 0 0 1 3.1-1.3L12 6.2Z" /> break;
        case "credit-card": <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M7 14h4" /> break;
        case "receipt": <path d="M5 3h14a2 2 0 0 1 2 2v16l-3-1.5-3 1.5-3-1.5L9 21l-3-1.5L3 21V5a2 2 0 0 1 2-2Z" /><path d="M7 8h10M7 12h10M7 16h5" /> break;
        case "barcode": <path d="M5 6v12M8 6v12M11 6v12M14 6v12M17 6v12M19 6v12" /> break;
        case "wallet": <path d="M4 6h14a2 2 0 0 1 2 2v10H4a2 2 0 0 1-2-2V6a3 3 0 0 1 3-3h12v3M15 11h7v4h-7a2 2 0 0 1 0-4Z" /> break;
        case "business": <path d="M3 21h18M5 21V7l7-4v18M12 9h7v12M8 10h1M8 14h1M8 18h1M15 13h1M15 17h1" /> break;
        case "warning": <path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" /> break;
        case "check-circle": <circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /> break;
        case "bank": <path d="m3 9 9-6 9 6M5 10h14M6 10v8M10 10v8M14 10v8M18 10v8M3 21h18" /> break;
        case "payments": <rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18M7 14h4" /> break;
        case "tune": <path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h7M15 18h5" /><circle cx="16" cy="6" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="13" cy="18" r="2" /> break;
        case "science": <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3M8 15h8" /> break;
        case "filter": <path d="M4 5h16l-6 7v5l-4 2v-7L4 5Z" /> break;
        case "pdf": <path d="M6 2h8l4 4v16H6zM14 2v5h5M9 13h2a2 2 0 0 1 0 4H9v-4Zm6 0v4M15 13h3" /> break;
        case "lock-user": <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14a2 2 0 1 0 0 4" /> break;
        case "cloud-off": <path d="m3 3 18 18M7.7 7.7A5 5 0 0 1 17 10h.5a3.5 3.5 0 0 1 2.5 6M5 16a4 4 0 0 1 .5-7.9M9 19h8" /> break;
        case "fact-check": <path d="M4 4h16v16H4zM8 9l1.5 1.5L12 8M14 9h3M8 15l1.5 1.5L12 14M14 15h3" /> break;
        case "sensors": <path d="M8.5 8.5a5 5 0 0 0 0 7M5.5 5.5a9 9 0 0 0 0 13M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /><circle cx="12" cy="12" r="2" /> break;
        case "sensors-off": <path d="m3 3 18 18M8.5 8.5a5 5 0 0 0 0 7M5.5 5.5a9 9 0 0 0 0 13M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /> break;
        default: <circle cx="12" cy="12" r="9" /> break;
    }
</svg>

@code {
    /// <summary>Icon name. See the switch above for the available keys
    /// (dashboard, users, key, shield, scope, palette, workflow, audit, chart,
    /// settings, menu, x, bell, search, eye-off, arrow-right, arrow-left, plus, external, volume, phone, inbox,
    /// alert, check, clock, database, lock, code, browser, device, server,
    /// terminal, info, calendar, chevron-left, chevron-right, chevron-down, refresh, trash, edit, pix, credit-card,
    /// receipt, barcode).</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Pixel size of the square viewBox (default 20).</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>Optional CSS class applied to the root &lt;svg&gt;.</summary>
    [Parameter]
    public string? CssClass { get; set; }
}
