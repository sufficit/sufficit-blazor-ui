@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<ul class="@Classname" style="@Style" @attributes="AdditionalAttributes">@ChildContent</ul>

@code {
    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Classname
        => SUIClassBuilder.Default("sui-list")
            .AddClass("sui-list--dense", Dense)
            .AddClass(Class)
            .Build();
}
