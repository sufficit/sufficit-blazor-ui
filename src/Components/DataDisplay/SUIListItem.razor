@namespace Sufficit.Blazor.UI.Components

<li class="@Classname">
    @if (_hasClick)
    {
        <button type="button" class="sui-list__button" @onclick="OnClickHandler">
            @ChildContent
        </button>
    }
    else
    {
        @ChildContent
    }
</li>

@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _hasClick => OnClick.HasDelegate;

    private string Classname
        => SUIClassBuilder.Default("sui-list__item")
            .AddClass("sui-list__item--clickable", _hasClick)
            .AddClass(Class)
            .Build();

    private Task OnClickHandler() => OnClick.InvokeAsync();
}
