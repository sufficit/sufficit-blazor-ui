@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<nav class="@Classname" aria-label="@AriaLabel">
    <SUIText Typo="SUITypo.caption" Color="SUIColor.Default" aria-live="polite">
        @RangeLabel
    </SUIText>

    <div class="sui-pagination__controls">
        @if (PageSizeOptions is { Count: > 0 })
        {
            <SUISelect TValue="int"
                       Label="Itens por página"
                       Value="@EffectivePageSize"
                       ValueChanged="ChangePageSizeAsync"
                       Class="sui-pagination__size">
                @foreach (var size in PageSizeOptions.Distinct().Where(value => value > 0).Order())
                {
                    <SUISelectItem Value="@size">@size</SUISelectItem>
                }
            </SUISelect>
        }

        <SUIText Typo="SUITypo.caption" Tag="SUITextTag.Span" Class="sui-pagination__page">
            Página @(EffectivePageIndex + 1) de @PageCount
        </SUIText>

        <SUIIconButton Icon="@SUIIcons.ChevronLeft"
                       Title="Página anterior"
                       SizeValue="SUISize.Small"
                       VariantValue="SUIVariant.Text"
                       Disabled="@(EffectivePageIndex == 0)"
                       OnClick="PreviousAsync" />
        <SUIIconButton Icon="@SUIIcons.ChevronRight"
                       Title="Próxima página"
                       SizeValue="SUISize.Small"
                       VariantValue="SUIVariant.Text"
                       Disabled="@(EffectivePageIndex >= PageCount - 1)"
                       OnClick="NextAsync" />
    </div>
</nav>

@code {
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public EventCallback<int> PageIndexChanged { get; set; }
    [Parameter] public IReadOnlyList<int>? PageSizeOptions { get; set; }
    [Parameter] public string ItemLabel { get; set; } = "itens";
    [Parameter] public string AriaLabel { get; set; } = "Paginação";

    private int EffectivePageSize => Math.Max(1, PageSize);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(Math.Max(0, TotalItems) / (double)EffectivePageSize));
    private int EffectivePageIndex => Math.Clamp(PageIndex, 0, PageCount - 1);
    private int FirstItem => TotalItems == 0 ? 0 : EffectivePageIndex * EffectivePageSize + 1;
    private int LastItem => Math.Min(TotalItems, (EffectivePageIndex + 1) * EffectivePageSize);
    private string RangeLabel => TotalItems == 0
        ? $"Nenhum {ItemLabel}"
        : $"{FirstItem:N0}–{LastItem:N0} de {TotalItems:N0} {ItemLabel}";
    private string Classname => SUIClassBuilder.Default("sui-pagination").AddClass(Class).Build();

    private Task PreviousAsync()
        => PageIndexChanged.InvokeAsync(Math.Max(0, EffectivePageIndex - 1));

    private Task NextAsync()
        => PageIndexChanged.InvokeAsync(Math.Min(PageCount - 1, EffectivePageIndex + 1));

    private async Task ChangePageSizeAsync(int value)
    {
        var normalized = Math.Max(1, value);
        await PageSizeChanged.InvokeAsync(normalized);
        await PageIndexChanged.InvokeAsync(0);
    }
}
