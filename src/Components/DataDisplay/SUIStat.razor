@namespace Sufficit.Blazor.UI.Components

<div class="@Classname" style="display:flex;min-block-size:6.4rem;align-items:flex-start;justify-content:space-between;gap:var(--sui-space-3);padding:var(--sui-space-4)">
    <div class="sui-stat__copy">
        <SUIText Typo="SUITypo.h5" Tag="SUITextTag.Div" Class="sui-stat__value">@Value</SUIText>
        <SUIText Typo="SUITypo.caption" Color="SUIColor.Default">@Label</SUIText>
    </div>
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <SUIAvatar SizeValue="SUISize.Small" ColorValue="@ColorValue">
            <SUIIcon Name="@Icon" Size="20" />
        </SUIAvatar>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public SUIColor ColorValue { get; set; } = SUIColor.Primary;
    [Parameter] public string? Class { get; set; }

    private string Classname => SUIClassBuilder.Default("sui-card sui-stat")
        .AddClass($"sui-stat--{SUIClassBuilder.Slug(ColorValue)}")
        .AddClass(Class)
        .Build();
}
