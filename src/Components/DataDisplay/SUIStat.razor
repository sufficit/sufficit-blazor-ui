@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@implements IDisposable
@using Sufficit.Blazor.UI.Services
@inject IServiceProvider Services

<div class="@Classname" style="@RootStyle" @attributes="AdditionalAttributes">
    @if (Decorated)
    {
        @* Decorative watermark: the same icon, large and faint, gives each tone its own texture. *@
        <span class="sui-stat__mark" aria-hidden="true"><SUIIcon Name="@Icon" Size="96" /></span>
    }
    @if (_changes > 0 && Has(SUIAnimation.ValueFlash))
    { <span @key="_changes" class="sui-stat__flash" aria-hidden="true"></span> }
    <div class="sui-stat__copy" aria-busy="@(Loading ? "true" : null)">
        @if (Loading)
        {
            @* Skeleton keeps the card's shape so the layout does not jump when data arrives. *@
            <span class="sui-stat__skeleton sui-stat__skeleton--value"></span>
            <span class="sui-stat__skeleton sui-stat__skeleton--label">@Label</span>
        }
        else
        {
        <SUIText Typo="SUITypo.h5" Tag="SUITextTag.Div" Class="sui-stat__value"><span @key="_changes" class="@(_changes > 0 && (Has(SUIAnimation.ValueChange) || Has(SUIAnimation.ValueGlow)) ? "sui-stat__number sui-stat__number--changed" : "sui-stat__number")">@_shown</span>@if (!string.IsNullOrWhiteSpace(Unit)) { <span class="sui-stat__unit">@Unit</span> }</SUIText>
        <SUIText Typo="SUITypo.caption" Color="@(Bold ? SUIColor.Inherit : SUIColor.Default)" Class="sui-stat__label">@Label</SUIText>
        @if (!string.IsNullOrWhiteSpace(Delta) || !string.IsNullOrWhiteSpace(Caption))
        {
            <div class="sui-stat__meta">
                @if (!string.IsNullOrWhiteSpace(Delta))
                {
                    <span class="sui-stat__delta sui-stat__delta--@DeltaTone" aria-label="@DeltaLabel">
                        <span aria-hidden="true">@TrendArrow</span>@Delta
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Caption)) { <span class="sui-stat__caption">@Caption</span> }
            </div>
        }
        @ChildContent
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <SUIAvatar SizeValue="SUISize.Small" ColorValue="@ColorValue" Class="sui-stat__icon">
            <SUIIcon Name="@Icon" Size="20" />
        </SUIAvatar>
    }
    @if (!Loading && SparkPoints is { } points)
    {
        <svg class="sui-stat__spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <polygon class="sui-stat__spark-area" points="0,24 @points 100,24" />
            <polyline class="sui-stat__spark-line" points="@points" />
        </svg>
    }
</div>

@code {
    /// <summary>Headline number, already formatted (e.g. "1,2 mil", "15 s").</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>Small suffix shown after the value (e.g. "/20", "%").</summary>
    [Parameter] public string? Unit { get; set; }
    /// <summary>What the number measures.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Icon name; also used as the faint watermark in the Soft, Gradient and Image appearances.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public SUIColor ColorValue { get; set; } = SUIColor.Primary;
    /// <summary>Surface treatment. Plain keeps the neutral card; Soft tints it; Gradient and Image are bold, light-on-color cards.</summary>
    [Parameter] public SUIStatAppearance Appearance { get; set; } = SUIStatAppearance.Plain;
    /// <summary>Background image URL for <see cref="SUIStatAppearance.Image"/>; a gradient in the card colour keeps text legible.</summary>
    [Parameter] public string? BackgroundImage { get; set; }
    /// <summary>Change against the comparison period, already formatted (e.g. "+12%").</summary>
    [Parameter] public string? Delta { get; set; }
    /// <summary>Direction of the change. Null hides the arrow.</summary>
    [Parameter] public SUITrend? Trend { get; set; }
    /// <summary>False for metrics where lower is better (abandonment, wait, errors): a fall is then shown as good.</summary>
    [Parameter] public bool HigherIsBetter { get; set; } = true;
    /// <summary>Secondary line, e.g. the comparison window ("vs. ontem") or a share ("82% atendidas").</summary>
    [Parameter] public string? Caption { get; set; }
    /// <summary>Optional series drawn as a small area chart along the bottom edge (no axes).</summary>
    [Parameter] public IReadOnlyList<double>? Sparkline { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Shows a skeleton (shimmering when <see cref="SUIAnimation.Loading"/> is enabled) instead of the value.</summary>
    [Parameter] public bool Loading { get; set; }
    /// <summary>Animations for this card; null uses the application default (<c>SUIThemeOptions.Animations</c>).</summary>
    [Parameter] public SUIAnimation? Animation { get; set; }

    private SUIAnimation Animations => SUIAnimationPolicy.Resolve(Animation, Services.GetService(typeof(SUIAnimationPolicy)) as SUIAnimationPolicy);
    private bool Has(SUIAnimation kind) => (Animations & kind) == kind;
    // Enter alone keeps its original look (fade + rise); explicit variants add to it.
    private bool EnterFade => Has(SUIAnimation.Enter) || Has(SUIAnimation.EnterFade);
    private bool EnterRise => Has(SUIAnimation.Enter) || Has(SUIAnimation.EnterRise);

    private string? _shown, _last;
    private int _changes;
    private CancellationTokenSource? _tween;

    protected override void OnParametersSet()
    {
        if (_last is null) { _shown = _last = Value; return; }
        if (Value == _last) return;
        var from = _last; _last = Value; _changes++;
        _tween?.Cancel();
        if (Has(SUIAnimation.CountUp) && TryNumber(from, out var start) && TryNumber(Value, out var end) && start != end)
        {
            _tween = new CancellationTokenSource();
            _ = CountAsync(start, end, _tween.Token);
        }
        else _shown = Value;
    }

    // Integers only (the displayed text is kept verbatim otherwise): 12 frames over ~480 ms, ease-out.
    private async Task CountAsync(long start, long end, CancellationToken token)
    {
        const int frames = 12;
        for (var frame = 1; frame <= frames && !token.IsCancellationRequested; frame++)
        {
            var t = 1 - Math.Pow(1 - frame / (double)frames, 3);
            _shown = frame == frames ? Value : Math.Round(start + (end - start) * t).ToString(System.Globalization.CultureInfo.InvariantCulture);
            await InvokeAsync(StateHasChanged);
            try { await Task.Delay(40, token); } catch (TaskCanceledException) { return; }
        }
    }

    private static bool TryNumber(string? text, out long value) =>
        long.TryParse(text, System.Globalization.NumberStyles.AllowLeadingSign, System.Globalization.CultureInfo.InvariantCulture, out value);

    public void Dispose() { _tween?.Cancel(); _tween?.Dispose(); }

    // Light-on-colour cards: the label inherits the card's white text instead of the secondary tone.
    private bool Bold => Appearance is SUIStatAppearance.Gradient or SUIStatAppearance.Image;
    private bool Decorated => Appearance != SUIStatAppearance.Plain && !string.IsNullOrWhiteSpace(Icon);

    private string Classname => SUIClassBuilder.Default("sui-card sui-stat")
        .AddClass($"sui-stat--{SUIClassBuilder.Slug(ColorValue)}")
        .AddClass($"sui-stat--{SUIClassBuilder.Slug(Appearance)}", Appearance != SUIStatAppearance.Plain)
        .AddClass("sui-stat--spark", SparkPoints is not null && !Loading)
        .AddClass("sui-stat--anim-enter", EnterFade || EnterRise || Has(SUIAnimation.EnterZoom))
        .AddClass("sui-stat--enter-fade", EnterFade)
        .AddClass("sui-stat--enter-rise", EnterRise)
        .AddClass("sui-stat--enter-zoom", Has(SUIAnimation.EnterZoom))
        .AddClass("sui-stat--anim-hover", Has(SUIAnimation.Hover))
        .AddClass("sui-stat--anim-loading", Loading && (Has(SUIAnimation.Loading) || Has(SUIAnimation.LoadingPulse)))
        .AddClass("sui-stat--load-shimmer", Loading && Has(SUIAnimation.Loading))
        .AddClass("sui-stat--load-pulse", Loading && Has(SUIAnimation.LoadingPulse))
        .AddClass("sui-stat--value-pop", Has(SUIAnimation.ValueChange))
        .AddClass("sui-stat--value-glow", Has(SUIAnimation.ValueGlow))
        .AddClass(Class)
        .Build();

    // Only a validated absolute/relative URL becomes a CSS url(); quotes and parentheses are rejected.
    private string? RootStyle
    {
        get
        {
            var image = Appearance == SUIStatAppearance.Image && Uri.TryCreate(BackgroundImage, UriKind.RelativeOrAbsolute, out var uri)
                && BackgroundImage!.IndexOfAny(['"', '\'', '(', ')', '\\', ';', '\n', '\r']) < 0
                && (!uri.IsAbsoluteUri || uri.Scheme is "https" or "http" or "data")
                ? $"--sui-stat-image:url(\"{BackgroundImage}\");" : null;
            return string.IsNullOrEmpty(image) ? Style : image + Style;
        }
    }

    private string DeltaTone => Trend switch
    {
        SUITrend.Up => HigherIsBetter ? "good" : "bad",
        SUITrend.Down => HigherIsBetter ? "bad" : "good",
        _ => "flat",
    };
    private string TrendArrow => Trend switch { SUITrend.Up => "▲ ", SUITrend.Down => "▼ ", SUITrend.Flat => "■ ", _ => "" };
    private string? DeltaLabel => Trend is null ? null : $"{Trend}: {Delta}";

    private string? SparkPoints
    {
        get
        {
            if (Sparkline is not { Count: >= 2 } values || values.Any(v => double.IsNaN(v) || double.IsInfinity(v))) return null;
            var min = values.Min(); var max = values.Max(); var span = max - min;
            var step = 100.0 / (values.Count - 1);
            // Leave a little headroom so the line never touches the card edge.
            return string.Join(" ", values.Select((v, i) => FormattableString.Invariant(
                $"{i * step:0.##},{(span <= 0 ? 12 : 22 - (v - min) / span * 18):0.##}")));
        }
    }
}
