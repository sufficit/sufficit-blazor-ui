@namespace Sufficit.Blazor.UI.Components
@typeparam T
@implements IAsyncDisposable
@inject IJSRuntime JS

@{
    var rows = Items as IReadOnlyList<T> ?? Items?.ToArray() ?? Array.Empty<T>();
    var activeRow = Math.Clamp(_activeRow, 0, Math.Max(0, rows.Count - 1));
}

<div @ref="_wrapperElement" class="@WrapperClass" aria-busy="@(Loading ? "true" : "false")">
    @if (Loading)
    {
        <SUIProgressLinear Indeterminate="true" Class="sui-table__progress" />
    }
    @* Clickable rows make this a grid: a row is an allowed focus target there
       (ARIA 1.2 row), unlike tr[role=button], which is not a valid role for a
       table row and makes any control inside it an illegal nested one. *@
    <table class="@Classname" role="@(OnRowClick.HasDelegate ? "grid" : null)" @attributes="AdditionalAttributes">
        @if (HeaderContent is not null)
        {
            <thead>
                <tr>@HeaderContent</tr>
            </thead>
        }
        <tbody>
            @if (rows.Count == 0)
            {
                @if (NoRecordsContent is not null)
                {
                    <tr class="sui-table__empty-row">
                        <td colspan="@EffectiveColumnCount">@NoRecordsContent</td>
                    </tr>
                }
            }
            else
            {
                @foreach (var indexedItem in rows.Select((item, index) => (item, index)))
                {
                    var item = indexedItem.item;
                    var index = indexedItem.index;
                    @if (OnRowClick.HasDelegate)
                    {
                        <tr @key="@(RowKey?.Invoke(item) ?? (object?)item ?? index)" class="@GetRowClass(item, index, interactive: true)"
                            style="@RowStyleFunc?.Invoke(item, index)"
                            aria-label="@RowAriaLabelFunc?.Invoke(item)"
                            tabindex="@(index == activeRow ? 0 : -1)"
                            @onclick="() => OnRowItemClick(item)"
                            @onfocus="() => _activeRow = index">
                            @RowTemplate?.Invoke(item)
                        </tr>
                    }
                    else
                    {
                        <tr @key="@(RowKey?.Invoke(item) ?? (object?)item ?? index)" class="@GetRowClass(item, index)"
                            style="@RowStyleFunc?.Invoke(item, index)">
                            @RowTemplate?.Invoke(item)
                        </tr>
                    }
                }
            }
        </tbody>
        @if (FooterContent is not null)
        {
            <tfoot><tr>@FooterContent</tr></tfoot>
        }
    </table>
</div>

@code {
    /// <summary>Stable identity retained when rows are sorted or paged.</summary>
    [Parameter] public Func<T, object>? RowKey { get; set; }

    /// <summary>Items to render. When null/empty, <see cref="NoRecordsContent"/> shows.</summary>
    [Parameter]
    public IEnumerable<T>? Items { get; set; }

    [Parameter]
    public bool Hover { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    /// <summary>
    /// Presents each body row as a labelled card on compact screens. Cells should
    /// provide <see cref="SUITd.DataLabel"/> so their column name remains visible.
    /// Desktop table semantics and layout are unchanged.
    /// </summary>
    [Parameter]
    public bool StackOnMobile { get; set; }

    /// <summary>Shows an indeterminate progress indicator and exposes aria-busy.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Optional class selector calculated for each rendered row.</summary>
    [Parameter]
    public Func<T, int, string?>? RowClassFunc { get; set; }

    /// <summary>Optional inline style calculated for each rendered row.</summary>
    [Parameter]
    public Func<T, int, string?>? RowStyleFunc { get; set; }

    /// <summary>
    /// Number of data columns. Used by the no-records cell so its
    /// <c>colspan</c> covers the full table.
    /// </summary>
    [Parameter]
    public int ColumnCount { get; set; } = 1;

    /// <summary>
    /// Called when a row is clicked or activated with Enter/Space (item passed).
    /// Setting it turns the table into a grid: one row is in the tab order and
    /// arrow keys, Home and End move between rows.
    /// </summary>
    [Parameter]
    public EventCallback<T> OnRowClick { get; set; }

    /// <summary>
    /// Optional accessible name for an interactive row, e.g. "Abrir pedido 42".
    /// Without it the row is announced by its cell contents.
    /// </summary>
    [Parameter]
    public Func<T, string?>? RowAriaLabelFunc { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment<T>? RowTemplate { get; set; }

    [Parameter]
    public RenderFragment? NoRecordsContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string WrapperClass
        => SUIClassBuilder.Default("sui-table-wrapper")
            .AddClass("sui-table-wrapper--stack-mobile", StackOnMobile)
            .Build();

    private string Classname
        => SUIClassBuilder.Default("sui-table")
            .AddClass("sui-table--hover", Hover)
            .AddClass("sui-table--dense", Dense)
            .AddClass("sui-table--stack-mobile", StackOnMobile)
            .AddClass(Class)
            .Build();

    private Task OnRowItemClick(T item) => OnRowClick.InvokeAsync(item);

    private ElementReference _wrapperElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _interop;
    // The row in the tab order (roving tabindex); follows focus.
    private int _activeRow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Row keys live in the module: it sees the event target, so a key
        // pressed on a control inside a row never activates the row itself.
        // A read-only table never loads it.
        if (_module is not null || !OnRowClick.HasDelegate)
            return;
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Sufficit.Blazor.UI/Components/DataDisplay/SUITable.razor.js");
        _interop = await _module.InvokeAsync<IJSObjectReference>("initialize", _wrapperElement);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_interop is not null)
                await _interop.InvokeVoidAsync("dispose");
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // The browser circuit may already be gone during disposal.
        }
    }

    private int EffectiveColumnCount => Math.Max(1, ColumnCount);

    private string GetRowClass(T item, int index, bool interactive = false)
        => SUIClassBuilder.Default("sui-table__row")
            .AddClass("sui-table__row--interactive", interactive)
            .AddClass(RowClassFunc?.Invoke(item, index))
            .Build();
}
