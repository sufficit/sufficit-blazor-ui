@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Web.Virtualization

@{
    var rows = Items as IReadOnlyList<TItem> ?? Items?.ToArray() ?? Array.Empty<TItem>();
    var activeRow = Math.Clamp(_activeRow, 0, Math.Max(0, rows.Count - 1));
    // One row renderer for both body paths; they differ only in who decides
    // which rows exist. Keeping it here (instead of a field) preserves the
    // per-render snapshot of the previous markup: the source is enumerated
    // exactly once per render, before any branch reads it.
    RenderFragment RenderRow((TItem item, int index) row) => @<tr
            @key="@(RowKey?.Invoke(row.item) ?? (object?)row.item ?? row.index)"
            class="@GetRowClass(row.item, row.index, interactive: OnRowClick.HasDelegate)"
            style="@RowStyleFunc?.Invoke(row.item, row.index)"
            aria-label="@(OnRowClick.HasDelegate ? RowAriaLabelFunc?.Invoke(row.item) : null)"
            tabindex="@(OnRowClick.HasDelegate ? (row.index == activeRow ? 0 : -1) : null)"
            @onclick="() => OnRowItemClick(row.item)"
            @onfocus="() => _activeRow = row.index">
        @RowTemplate?.Invoke(row.item)
    </tr>;
}

<div @ref="_wrapperElement" class="@WrapperClass" aria-busy="@(Loading ? "true" : "false")"
     role="@(ScrollRegion ? "region" : null)"
     aria-label="@(ScrollRegion ? ScrollLabel : null)"
     tabindex="@(ScrollRegion ? 0 : null)">
    @if (Loading)
    {
        <SUIProgressLinear Indeterminate="true" Class="sui-table__progress" />
    }
    @* Clickable rows make this a grid: a row is an allowed focus target there
       (ARIA 1.2 row), unlike tr[role=button], which is not a valid role for a
       table row and makes any control inside it an illegal nested one. *@
    <table class="@Classname" style="@Style" role="@(OnRowClick.HasDelegate ? "grid" : null)" @attributes="AdditionalAttributes">
        @if (HeaderContent is not null)
        {
            <thead>
                <tr>@HeaderContent</tr>
            </thead>
        }
        <tbody>
            @if (rows.Count == 0)
            {
                @if (NoRecordsContent is not null)
                {
                    <tr class="sui-table__empty-row">
                        <td class="sui-table__empty-cell" colspan="@EffectiveColumnCount">@NoRecordsContent</td>
                    </tr>
                }
            }
            else if (Virtualize)
            {
                @* Spacer rows must be table rows too: the framework default
                   (div) is hoisted out of the table by the HTML parser and
                   breaks the grid geometry. An empty tr whose height the
                   framework sets keeps the scrollbar inside the row group.
                   The index pairs below carry the original position to each
                   rendered row: ItemContent hands back the item alone, and
                   searching it back in rows would misindex duplicate values. *@
                var indexed = rows.Select((item, index) => new IndexedRow(item, index)).ToArray();
                <Virtualize TItem="IndexedRow" Items="indexed" ItemSize="ItemSize"
                            OverscanCount="OverscanCount" SpacerElement="tr">
                    <ItemContent Context="row">@RenderRow((row.Item, row.Index))</ItemContent>
                </Virtualize>
            }
            else
            {
                @foreach (var indexedItem in rows.Select((item, index) => (item, index)))
                {
                    @RenderRow(indexedItem)
                }
            }
        </tbody>
        @if (FooterContent is not null)
        {
            <tfoot><tr>@FooterContent</tr></tfoot>
        }
    </table>
</div>
