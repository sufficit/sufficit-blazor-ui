@namespace Sufficit.Blazor.UI.Components

<li class="@Classname" @attributes="AdditionalAttributes">
    <span class="sui-timeline__marker sui-timeline__marker--@SizeSlug sui-timeline__marker--@ToneSlug sui-timeline__marker--@VariantSlug" aria-hidden="true"></span>
    <div class="sui-timeline__body">
        @ChildContent
    </div>
</li>

@code {
    /// <summary>Marker color: "default", "primary", "success", "warning", "error", "info".</summary>
    [Parameter, Obsolete("Use ColorValue. The object bridge will be removed in v2.0.0.")]
    public object? Color { get; set; } = SUIColor.Primary;

    /// <summary>"small" or "medium". Default "small".</summary>
    [Parameter, Obsolete("Use SizeValue. The object bridge will be removed in v2.0.0.")]
    public object? Size { get; set; } = SUISize.Small;

    /// <summary>"filled" or "outlined". Default "filled".</summary>
    [Parameter, Obsolete("Use VariantValue. The object bridge will be removed in v2.0.0.")]
    public object? Variant { get; set; } = SUIVariant.Filled;

    [Parameter] public SUIColor? ColorValue { get; set; }
    [Parameter] public SUISize? SizeValue { get; set; }
    [Parameter] public SUIVariant? VariantValue { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

#pragma warning disable CS0618
    private string ToneSlug => SUIClassBuilder.Slug(ColorValue ?? Color ?? SUIColor.Primary);
    private string VariantSlug => SUIClassBuilder.Slug(VariantValue ?? Variant ?? SUIVariant.Filled);

    /// <summary>
    /// Size slug shared by the item and its marker. The marker previously got
    /// only the tone and variant classes, so a "small" timeline rendered the
    /// item with small spacing but the marker at the base 24px — and the
    /// marker's own centring rule (which assumes the base size) left it sitting
    /// below the text.
    /// </summary>
    private string SizeSlug => SUIClassBuilder.Slug(SizeValue ?? Size ?? SUISize.Small);

    private string Classname
        => SUIClassBuilder.Default("sui-timeline__item")
            .AddClass($"sui-timeline__item--{SizeSlug}")
            .AddClass(Class)
            .Build();
#pragma warning restore CS0618
}
