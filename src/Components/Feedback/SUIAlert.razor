@namespace Sufficit.Blazor.UI.Components

<div class="@Classname" role="alert" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="sui-alert__icon">
            <SUIIcon Name="@Icon" Size="20" />
        </span>
    }
    <div class="sui-alert__content">
        @ChildContent
    </div>
    @if (ShowCloseIcon)
    {
        <button type="button" class="sui-alert__close" aria-label="Fechar" @onclick="HandleCloseAsync">
            <SUIIcon Name="x" Size="18" />
        </button>
    }
</div>

@* Alert é o veículo de PROMOÇÃO do sistema: ele tira um texto da corrida e
   transforma em outro tipo de objeto. Duas regras que decidem se cabe aqui,
   ambas em docs/DESIGN-VISUAL-HIERARCHY.md:

   1. Pintar um texto de laranja NÃO é promover — some na varredura e não
      existe para quem não distingue tom. Promoção é forma.
   2. Promover tudo não promove nada. Reserve para o que interrompe o
      trabalho de quem lê: reinicia, derruba a sessão, apaga, cobra. *@
@code {
    [Parameter]
    public SUITone? ToneValue { get; set; }

    [Parameter]
    public bool ShowCloseIcon { get; set; }

    /// <summary>Raised when the close icon is activated.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Optional icon name (resolved by SUIIcon). When null, no icon
    /// is shown unless the tone implies one.</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string Classname
    {
        get
        {
            var tone = SUIClassBuilder.Slug(ToneValue ?? SUITone.Info);
            return SUIClassBuilder.Default($"sui-alert sui-alert--{tone}")
                .AddClass(Class)
                .Build();
        }
    }

    private Task HandleCloseAsync() => OnClose.InvokeAsync();
}
