@namespace Sufficit.Blazor.UI.Components

<div class="@Classname" role="alert" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="sui-alert__icon">
            <SUIIcon Name="@Icon" Size="20" />
        </span>
    }
    <div class="sui-alert__content">
        @ChildContent
    </div>
    @if (ShowCloseIcon)
    {
        <button type="button" class="sui-alert__close" aria-label="Fechar" @onclick="OnClose">
            <SUIIcon Name="x" Size="18" />
        </button>
    }
</div>

@* Alert é o veículo de PROMOÇÃO do sistema: ele tira um texto da corrida e
   transforma em outro tipo de objeto. Duas regras que decidem se cabe aqui,
   ambas em docs/DESIGN-VISUAL-HIERARCHY.md:

   1. Pintar um texto de laranja NÃO é promover — some na varredura e não
      existe para quem não distingue tom. Promoção é forma.
   2. Promover tudo não promove nada. Reserve para o que interrompe o
      trabalho de quem lê: reinicia, derruba a sessão, apaga, cobra. *@
@code {
    /// <summary>Alert tone. Accepts a lowercase string ("info", "success",
    /// "warning", "danger", "error") for compatibility, defaulting to "info".
    /// "error" is mapped to the danger style.</summary>
    [Parameter, Obsolete("Use ToneValue. The string bridge will be removed in v2.0.0.")]
    public string Severity { get; set; } = "info";

    [Parameter]
    public SUITone? ToneValue { get; set; }

    [Parameter]
    public bool ShowCloseIcon { get; set; }

    [Parameter]
    public EventCallback CloseIconClicked { get; set; }

    /// <summary>Optional icon name (resolved by SUIIcon). When null, no icon
    /// is shown unless the tone implies one.</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string Classname
    {
        get
        {
            // "error" and "danger" both map to the danger style.
#pragma warning disable CS0618
            var legacyTone = Severity.Equals("error", StringComparison.OrdinalIgnoreCase)
                ? "danger" : Severity.ToLowerInvariant();
#pragma warning restore CS0618
            var tone = ToneValue is { } typedTone
                ? SUIClassBuilder.Slug(typedTone)
                : legacyTone;
            return SUIClassBuilder.Default($"sui-alert sui-alert--{tone}")
                .AddClass(Class)
                .Build();
        }
    }

    private Task OnClose() => CloseIconClicked.InvokeAsync();
}
