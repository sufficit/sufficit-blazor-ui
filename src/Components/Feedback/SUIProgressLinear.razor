@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using System.Globalization

<div class="@Classname" role="progressbar"
     aria-valuenow="@ClampedValue" aria-valuemin="0" aria-valuemax="100"
     aria-label="@AriaLabel" style="@Style" @attributes="AdditionalAttributes">
    <div class="sui-progress-linear__bar" data-sui-style="@ProgressCssomStyle"></div>
</div>

@code {
    /// <summary>Progress 0-100.</summary>
    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public SUIColor? ColorValue { get; set; }

    [Parameter]
    public bool Rounded { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }


    private string Classname
        => SUIClassBuilder.Default("sui-progress-linear")
            .AddClass($"sui-progress-linear--{SUIClassBuilder.Slug(EffectiveColor)}")
            .AddClass("sui-progress-linear--rounded", Rounded)
            .AddClass(Class)
            .Build();

    private double ClampedValue
        => double.IsFinite(Value) ? Math.Clamp(Value, 0, 100) : 0;

    // CSSOM via data-sui-style: a style attribute is ignored under style-src-attr 'none'.
    // Before JS runs the bar is empty and then grows (transform, no layout shift).
    private string? ProgressCssomStyle
        => SUIStyleBuilder.Default()
            .Add("--sui-progress-scale", (ClampedValue / 100).ToString("0.####", CultureInfo.InvariantCulture))
            .Build();

    private SUIColor EffectiveColor => ColorValue ?? SUIColor.Primary;
}
