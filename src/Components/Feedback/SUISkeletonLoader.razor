@* Skeleton Loader Component - Loading State Pattern *@
@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div class="@Classname" style="@Style" @attributes="AdditionalAttributes">
    @if (Type == SUISkeletonType.Card)
    {
        <div class="sui-skeleton sui-skeleton-card"></div>
    }
    else if (Type == SUISkeletonType.Text)
    {
        <div class="sui-skeleton sui-skeleton-text"></div>
    }
    else if (Type == SUISkeletonType.Circle)
    {
        <div class="sui-skeleton sui-skeleton-circle" data-sui-style="@CircleCssomStyle"></div>
    }
    else if (Type == SUISkeletonType.Table)
    {
        @for (int i = 0; i < Rows; i++)
        {
            <div class="sui-skeleton sui-skeleton-text sui-skeleton-text--table"></div>
        }
    }
</div>

@code {
    [Parameter]
    public SUISkeletonType Type { get; set; } = SUISkeletonType.Text;

    [Parameter]
    public int Rows { get; set; } = 3;

    [Parameter]
    public string Size { get; set; } = "48px";

    private string Classname
        => EffectiveClass("sui-skeleton-loader");

    // CSSOM via data-sui-style (a style attribute is ignored under style-src-attr 'none');
    // the CSS fallback is the default 48px.
    private string? CircleCssomStyle
        => SUIStyleBuilder.Default().Add("--sui-skeleton-size", Size, Size != "48px").Build();
}
