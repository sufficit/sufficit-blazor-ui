@namespace Sufficit.Blazor.UI.Components
@using Sufficit.Blazor.UI.Services
@inherits SUINotificationHostBase<SUISnackbarEntry>
@inject ISUISnackbar Snackbar

<div class="sui-snackbar-host" aria-live="polite" aria-atomic="true">
    @foreach (var entry in Entries)
    {
        var id = entry.Id;
        <div class="sui-snackbar sui-snackbar--@entry.Severity" role="status"
             @onmouseenter="() => Pause(id)" @onmouseleave="() => Resume(id)"
             @onfocusin="() => Pause(id)" @onfocusout="() => Resume(id)">
            <span class="sui-snackbar__message">@entry.Message</span>
            <button type="button" class="sui-snackbar__close" aria-label="Fechar" @onclick="() => Dismiss(id)">
                <SUIIcon Name="x" Size="16" />
            </button>
        </div>
    }
</div>

@code {
    // Snackbar is passive information: a longer, shallower stack than toast.
    protected override int MaxVisible => 5;

    protected override Guid IdOf(SUISnackbarEntry entry) => entry.Id;
    protected override DateTime ExpiresAtOf(SUISnackbarEntry entry) => entry.ExpiresAt;
    protected override SUISnackbarEntry WithExpiresAt(SUISnackbarEntry entry, DateTime expiresAt)
        => entry with { ExpiresAt = expiresAt };
    protected override void Subscribe(Action<SUISnackbarEntry> handler) => Snackbar.OnEnqueue += handler;
    protected override void Unsubscribe(Action<SUISnackbarEntry> handler) => Snackbar.OnEnqueue -= handler;
}
