@namespace Sufficit.Blazor.UI.Components

<span class="@Classname" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <SUIIcon Name="@Icon" Size="14" />
    }
    @ChildContent
</span>

@code {
    [Parameter]
    public SUITone? ToneValue { get; set; }

    /// <summary>Optional icon name (resolved by <see cref="SUIIcon"/>).</summary>
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private SUITone EffectiveTone => ToneValue ?? SUITone.Neutral;

    private string Classname
        => $"sui-status-badge sui-status-badge--{SUIClassBuilder.Slug(EffectiveTone)}";
}
