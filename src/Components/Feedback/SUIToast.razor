@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div id="@Id" class="@Classname" style="@Style"
     role="alert" aria-live="assertive" @attributes="AdditionalAttributes"
     @onmouseenter="OnPause" @onmouseleave="OnResume"
     @onfocusin="OnPause" @onfocusout="OnResume">
    <span class="sui-toast__icon" aria-hidden="true">@Icon</span>

    <div class="sui-toast__content">
        @ChildContent
    </div>
    @if (Dismissible)
    {
        <button class="sui-toast__dismiss dismiss" type="button" aria-label="@DismissLabel"
                @onclick="DismissAsync">×</button>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public SUIColor Color { get; set; } = SUIColor.Error;
    [Parameter] public string Icon { get; set; } = "⚠";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public string DismissLabel { get; set; } = "Fechar";
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Raised when the pointer enters the toast (hosts pause the countdown).</summary>
    [Parameter] public EventCallback OnPause { get; set; }

    /// <summary>Raised when the pointer leaves the toast (hosts resume the countdown).</summary>
    [Parameter] public EventCallback OnResume { get; set; }

    /// <summary>Legacy alias for <see cref="SUIComponentBase.AdditionalAttributes"/>.</summary>
    [Parameter, Obsolete("Use AdditionalAttributes instead; this alias will be removed in the next breaking release.")]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    protected override void OnParametersSet()
    {
#pragma warning disable CS0618 // deliberate bridge for the obsolete parameter
        MergeLegacyAttributes(UserAttributes);
#pragma warning restore CS0618
    }

    private string Classname
        => EffectiveClass($"sui-toast sui-toast--{Color.ToString().ToLowerInvariant()}");

    private Task DismissAsync() => OnDismiss.InvokeAsync();
}
