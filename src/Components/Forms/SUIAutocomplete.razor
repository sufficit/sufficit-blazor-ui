@namespace Sufficit.Blazor.UI.Components
@typeparam T
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable

<div class="@Classname" @onfocusout="OnFocusOutAsync" @attributes="UserAttributes">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label id="@LabelId" class="sui-field__label" for="@EffectiveId">@Label</label>
    }

    <div class="sui-autocomplete__control">
        <input id="@EffectiveId"
               class="sui-field__input"
               type="text"
               role="combobox"
               autocomplete="off"
               aria-autocomplete="list"
               aria-expanded="@(_open ? "true" : "false")"
               aria-controls="@ListId"
               aria-activedescendant="@ActiveDescendantId"
               aria-labelledby="@LabelledBy"
               aria-describedby="@DescribedBy"
               aria-invalid="@(Invalid ? "true" : "false")"
               aria-errormessage="@ErrorMessageId"
               value="@_query"
               @oninput="OnInputAsync"
               @onfocus="OnFocus"
               @onkeydown="OnKeyDownAsync"
               placeholder="@Placeholder"
               disabled="@Disabled" />
        @if (!string.IsNullOrWhiteSpace(AdornmentIcon))
        {
            <span class="sui-autocomplete__adornment" aria-hidden="true">
                <SUIIcon Name="@AdornmentIcon" Size="18" />
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <span id="@HelperId" class="sui-field__helper">@HelperText</span>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <span id="@ErrorId" class="sui-field__error">@ErrorText</span>
    }

    <span id="@StatusId" class="sui-sr-only" role="status" aria-live="polite">@StatusMessage</span>

    <ul id="@ListId"
        class="sui-autocomplete__list"
        role="listbox"
        aria-labelledby="@LabelledBy"
        hidden="@(!_open)">
        @if (_loading)
        {
            <li class="sui-autocomplete__noitems" role="presentation">@LoadingText</li>
        }
        else if (!string.IsNullOrWhiteSpace(_searchError))
        {
            <li class="sui-autocomplete__noitems" role="presentation">@_searchError</li>
        }
        else if (_items.Count == 0)
        {
            <li class="sui-autocomplete__noitems" role="presentation">
                @if (NoItemsTemplate is not null)
                {
                    @NoItemsTemplate
                }
                else
                {
                    @NoItemsText
                }
            </li>
        }
        else
        {
            @for (var index = 0; index < _items.Count; index++)
            {
                var item = _items[index];
                <li id="@OptionId(index)"
                    class="@OptionClass(index)"
                    role="option"
                    aria-selected="@(index == _activeIndex ? "true" : "false")"
                    @onmousedown:preventDefault="true"
                    @onclick="() => SelectAsync(item)">
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        <span>@ToDisplayString(item)</span>
                    }
                </li>
            }
        }
    </ul>
</div>
