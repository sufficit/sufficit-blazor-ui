@implements IDisposable
@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Utilities

<label class="@ClassName" style="@Style" @attributes="AdditionalAttributes">
    <input class="sui-checkbox__input"
           id="@InputId"
           name="@Name"
           type="checkbox"
           value="@FormValue"
           checked="@Value"
           disabled="@Disabled"
           aria-label="@AriaLabel"
           aria-invalid="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? "true" : null)"
           aria-describedby="@DescribedBy"
           aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
           @onchange="OnChanged" />
    @* The tick is always in the markup and revealed by :checked, so the box
       shows the state the browser already has. Rendering it from Value made
       the control depend on a re-render: under static server rendering that
       never comes, and the box stayed empty however many times it was
       clicked. *@
    <span class="sui-checkbox__box" aria-hidden="true">
        <SUIIcon Name="check" Size="16" />
    </span>
    @if (HasHelper)
    {
        <span class="sui-checkbox__text">
            @RenderLabel()
            <span id="@HelperId" class="sui-field__helper sui-checkbox__helper">@(HelperContent ?? (RenderFragment)(b => b.AddContent(0, HelperText)))</span>
        </span>
    }
    else
    {
        @RenderLabel()
    }
</label>

@if (EffectiveErrorText is not null)
{
    <span id="@ErrorId" class="sui-field__error" role="alert">@EffectiveErrorText</span>
}

@code {
    public void Dispose() => _field.Dispose();

    protected override void OnParametersSet() => _field.Configure(FormContext, ValueExpression, () => _ = InvokeAsync(StateHasChanged));

    [CascadingParameter] private Microsoft.AspNetCore.Components.Forms.EditContext? FormContext { get; set; }
    private readonly SUIFieldBinding<bool> _field = new();
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? ValueExpression { get; set; }
    private string? EffectiveErrorText => _field.Error;

    private string ErrorId => $"{InputId}-error";
    private string HelperId => $"{InputId}-helper";
    private bool HasHelper => HelperContent is not null || !string.IsNullOrWhiteSpace(HelperText);
    private string? DescribedBy
        => string.Join(' ', new[]
            {
                HasHelper ? HelperId : null,
                string.IsNullOrWhiteSpace(EffectiveErrorText) ? null : ErrorId,
            }.Where(id => id is not null)) is { Length: > 0 } ids ? ids : null;

    private RenderFragment RenderLabel() => __builder =>
    {
        if (ChildContent is not null)
        {
            <span class="sui-checkbox__label">@ChildContent</span>
        }
        else if (!string.IsNullOrWhiteSpace(Label))
        {
            <span class="sui-checkbox__label">@Label</span>
        }
    };

    /// <summary>
    /// Markup for the label area (e.g. text with a link or inline code); takes
    /// precedence over <see cref="Label"/> and stays inside the clickable label.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Secondary description rendered under the label with the shared field
    /// helper styling and linked to the box through <c>aria-describedby</c>.
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>Markup helper content; takes precedence over <see cref="HelperText"/>.</summary>
    [Parameter]
    public RenderFragment? HelperContent { get; set; }
    private readonly string _generatedInputId = $"sui-checkbox-{Guid.NewGuid():N}";

    /// <summary>Whether the checkbox is selected.</summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>Raised after the user changes the selected state.</summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Optional visible text associated with the checkbox.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Optional form field name.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// What the browser submits for this box when it is checked inside a plain
    /// HTML form — not the checked state, which is <see cref="Value"/>. A
    /// checkbox with no value attribute submits the literal "on", which an
    /// endpoint parsing a boolean cannot read; set this to the token the
    /// receiver expects, usually "true". Left unset the HTML default is kept,
    /// so existing forms are unaffected. An unchecked box submits nothing at
    /// all, so the receiver has to read an absent field as false.
    /// </summary>
    [Parameter]
    public string? FormValue { get; set; }

    /// <summary>Optional stable input id. A unique id is generated when omitted.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>Accessible name when the checkbox has no visible label.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public SUIColor? ColorValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }




    private string InputId
        => string.IsNullOrWhiteSpace(Id) ? _generatedInputId : Id!;

    private string ClassName
        => SUIClassBuilder.Default("sui-checkbox")
            .AddClass("sui-checkbox--checked", Value)
            .AddClass("sui-checkbox--disabled", Disabled)
            .AddClass("sui-checkbox--described", HasHelper)
            .AddClass($"sui-checkbox--{SUIClassBuilder.Slug(EffectiveColor)}")
            .AddClass(Class)
            .Build();

    private async Task OnChanged(ChangeEventArgs args)
    {
        if (Disabled) return;
        var value = args.Value switch
        {
            bool booleanValue => booleanValue,
            string stringValue => bool.TryParse(stringValue, out var parsed) && parsed,
            _ => false,
        };

        await ValueChanged.InvokeAsync(value);
        _field.Notify();
    }

    private SUIColor EffectiveColor => ColorValue ?? SUIColor.Primary;
}
