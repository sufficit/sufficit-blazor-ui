@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div @attributes="AdditionalAttributes"
     class="@Classname"
     style="@StyleValue"
     data-sui-align-row>
    @ChildContent
    @if (FullWidthContent is not null)
    {
        <div class="sui-form-grid__full-width">
            @FullWidthContent
        </div>
    }
</div>

@code {
    /// <summary>Number of equal-width columns before the mobile breakpoint (1-4).</summary>
    [Parameter]
    public int Columns { get; set; } = 2;

    /// <summary>Spacing token index (0-6). Defaults to <c>--sui-space-4</c>.</summary>
    [Parameter]
    public int Spacing { get; set; } = 4;

    /// <summary>
    /// Equivalent label lines reserved while fields are side by side (1-3).
    /// The reservation is removed when the grid stacks.
    /// </summary>
    [Parameter]
    public int LabelLines { get; set; } = 2;

    /// <summary>Minimum comfortable column width when adaptive stacking is enabled.</summary>
    [Parameter]
    public string MinColumnWidth { get; set; } = "14rem";

    /// <summary>Stacks below 44rem or when the containing panel cannot fit the columns.</summary>
    [Parameter]
    public bool StackOnMobile { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Content spanning every column after the regular fields, using the same Spacing gap.</summary>
    [Parameter]
    public RenderFragment? FullWidthContent { get; set; }

    private int EffectiveColumns => Math.Clamp(Columns, 1, 4);
    private int EffectiveSpacing => Math.Clamp(Spacing, 0, 6);
    private int EffectiveLabelLines => Math.Clamp(LabelLines, 1, 3);

    private const string DefaultMinColumnWidth = "14rem";

    // Columns, gap and label lines are classes, not an inline style: a page
    // whose CSP drops style-src-attr 'unsafe-inline' would otherwise lose the
    // whole grid layout. Only a non-default minimum width or a caller Style
    // still needs the attribute.
    private string Classname
        => SUIClassBuilder.Default("sui-form-grid")
            .AddClass($"sui-form-grid--columns-{EffectiveColumns}")
            .AddClass($"sui-form-grid--gap-{EffectiveSpacing}")
            .AddClass($"sui-form-grid--label-lines-{EffectiveLabelLines}")
            .AddClass("sui-form-grid--stack-mobile", StackOnMobile)
            .AddClass("sui-form-grid--single", EffectiveColumns == 1)
            .AddClass(Class)
            .Build();

    private string? StyleValue
    {
        get
        {
            var minWidth = string.IsNullOrWhiteSpace(MinColumnWidth) || MinColumnWidth == DefaultMinColumnWidth
                ? string.Empty
                : $"--sui-form-grid-min-width:{MinColumnWidth};";
            var value = minWidth + (string.IsNullOrWhiteSpace(Style) ? string.Empty : Style);
            return value.Length == 0 ? null : value;
        }
    }
}
