@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div @attributes="AdditionalAttributes"
     class="@Classname"
     style="@Style"
     data-sui-style="@CssomStyle"
     data-sui-align-row>
    @ChildContent
    @if (FullWidthContent is not null)
    {
        <div class="sui-form-grid__full-width">
            @FullWidthContent
        </div>
    }
</div>

@code {
    /// <summary>Number of equal-width columns before the mobile breakpoint (1-4).</summary>
    [Parameter]
    public int Columns { get; set; } = 2;

    /// <summary>
    /// Optional CSS <c>grid-template-columns</c> for unequal columns, e.g.
    /// <c>"2fr 1fr"</c> or <c>"minmax(0, 1fr) 12rem"</c>. Overrides the equal
    /// <see cref="Columns"/> split above the mobile breakpoint; with
    /// <see cref="StackOnMobile"/> the grid still collapses to one column below it.
    /// </summary>
    [Parameter]
    public string? ColumnTemplate { get; set; }

    /// <summary>Spacing token index (0-6). Defaults to <c>--sui-space-4</c>.</summary>
    [Parameter]
    public int Spacing { get; set; } = 4;

    /// <summary>
    /// Equivalent label lines reserved while fields are side by side (1-3).
    /// The reservation is removed when the grid stacks.
    /// </summary>
    [Parameter]
    public int LabelLines { get; set; } = 2;

    /// <summary>Minimum comfortable column width when adaptive stacking is enabled.</summary>
    [Parameter]
    public string MinColumnWidth { get; set; } = "14rem";

    /// <summary>Stacks below 44rem or when the containing panel cannot fit the columns.</summary>
    [Parameter]
    public bool StackOnMobile { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Content spanning every column after the regular fields, using the same Spacing gap.</summary>
    [Parameter]
    public RenderFragment? FullWidthContent { get; set; }

    private int EffectiveColumns => Math.Clamp(Columns, 1, 4);
    private int EffectiveSpacing => Math.Clamp(Spacing, 0, 6);
    private int EffectiveLabelLines => Math.Clamp(LabelLines, 1, 3);

    private const string DefaultMinColumnWidth = "14rem";

    // Validated by the same allow-list the JS initializer applies; an invalid
    // template falls back to the equal split instead of leaking a declaration.
    private bool HasTemplate => SUIStyleBuilder.IsSafeValue(ColumnTemplate);

    // Columns, gap and label lines are classes, not an inline style: a page
    // whose CSP has style-src-attr 'none' ignores a style attribute. Free-form values
    // (template, minimum width) go through data-sui-style (CSSOM); before JS
    // runs, a template grid shows its track count as equal columns.
    private string Classname
        => SUIClassBuilder.Default("sui-form-grid")
            .AddClass($"sui-form-grid--columns-{(HasTemplate ? TemplateTrackCount : EffectiveColumns)}")
            .AddClass($"sui-form-grid--gap-{EffectiveSpacing}")
            .AddClass($"sui-form-grid--label-lines-{EffectiveLabelLines}")
            .AddClass("sui-form-grid--stack-mobile", StackOnMobile)
            .AddClass("sui-form-grid--single", EffectiveColumns == 1 && !HasTemplate)
            .AddClass("sui-form-grid--template", HasTemplate)
            .AddClass(Class)
            .Build();

    private string? CssomStyle
        => SUIStyleBuilder.Default()
            .Add("--sui-form-grid-min-width", MinColumnWidth, MinColumnWidth != DefaultMinColumnWidth)
            .Add("--sui-form-grid-template", ColumnTemplate, HasTemplate)
            .Build();

    // Top-level tracks of the template (1-4), for the prerender fallback.
    private int TemplateTrackCount
    {
        get
        {
            int depth = 0, count = 0;
            var inTrack = false;
            foreach (var character in ColumnTemplate!)
            {
                depth += character == '(' ? 1 : character == ')' ? -1 : 0;
                var separator = depth == 0 && char.IsWhiteSpace(character);
                if (!separator && !inTrack) count++;
                inTrack = !separator;
            }
            return Math.Clamp(count, 1, 4);
        }
    }
}
