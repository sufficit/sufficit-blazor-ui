@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS
@using System.Globalization
@namespace Sufficit.Blazor.UI.Components
@typeparam T

<div class="@Classname">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="sui-field__label" for="@EffectiveId">@Label</label>
    }
    <input @ref="_inputElement" class="sui-field__input"
           id="@EffectiveId"
           type="number"
           value="@FormattedValue"
           @onchange="OnChanged"
           @oninput="OnInput"
           min="@(_hasMin ? Convert.ToString(Min, CultureInfo.InvariantCulture) : null)"
           max="@(_hasMax ? Convert.ToString(Max, CultureInfo.InvariantCulture) : null)"
           step="@Step"
           disabled="@Disabled"
           aria-describedby="@DescribedBy"
           aria-invalid="@(HasError ? "true" : null)"
           aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
           @attributes="UserAttributes" />
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <span id="@HelperId" class="sui-field__helper">@HelperText</span>
    }
    @if (FormContext is not null || !string.IsNullOrWhiteSpace(EffectiveErrorText))
    {
        <span id="@ErrorId" class="sui-field__error" style="min-height:1.3em">@EffectiveErrorText</span>
    }
</div>

@code {
    private bool _hasMin;
    private bool _hasMax;
    public override Task SetParametersAsync(ParameterView parameters)
    {
        _hasMin = parameters.TryGetValue<T?>(nameof(Min), out _);
        _hasMax = parameters.TryGetValue<T?>(nameof(Max), out _);
        return base.SetParametersAsync(parameters);
    }

    private ElementReference _inputElement;
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || (!ChangeOnWheel && _module is null)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/Sufficit.Blazor.UI/Components/Forms/SUINumericField.razor.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        await _module.InvokeVoidAsync("configure", _inputElement, ChangeOnWheel);
    }

    public void Dispose() { _disposed = true; _field.Dispose(); }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("disconnect", _inputElement);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    protected override void OnParametersSet() => _field.Configure(FormContext, ValueExpression, () => _ = InvokeAsync(StateHasChanged));

    [CascadingParameter] private Microsoft.AspNetCore.Components.Forms.EditContext? FormContext { get; set; }
    private readonly SUIFieldBinding<T?> _field = new();
    [Parameter] public System.Linq.Expressions.Expression<Func<T?>>? ValueExpression { get; set; }
    private string? EffectiveErrorText => ErrorText ?? _field.Error;

    [Parameter]
    public T? Value { get; set; }

    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public bool Invalid { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? AriaDescribedBy { get; set; }

    [Parameter]
    public T? Min { get; set; }

    [Parameter]
    public T? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }

    /// <summary>Publish parsed values on input instead of waiting for change/blur. Defaults to false.</summary>
    [Parameter] public bool Immediate { get; set; }

    /// <summary>Use the mouse wheel to step a focused field within Min/Max. Defaults to false; Step="any" does not step.</summary>
    [Parameter] public bool ChangeOnWheel { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();

    private readonly string _generatedId = $"sui-numeric-field-{Guid.NewGuid():N}";
    private string EffectiveId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id;
    private string HelperId => $"{EffectiveId}-helper";
    private string ErrorId => $"{EffectiveId}-error";
    private bool HasError => Invalid || !string.IsNullOrWhiteSpace(EffectiveErrorText);
    private string? DescribedBy
        => string.Join(' ', new[]
            {
                AriaDescribedBy,
                string.IsNullOrWhiteSpace(HelperText) ? null : HelperId,
                string.IsNullOrWhiteSpace(EffectiveErrorText) ? null : ErrorId,
            }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string Classname
        => SUIClassBuilder.Default("sui-field")
            .AddClass(Class)
            .Build();

    private string? FormattedValue
        => Value is null
            ? null
            : Convert.ToString(Value, CultureInfo.InvariantCulture);

    private Task OnChanged(ChangeEventArgs e)
        => Immediate ? Task.CompletedTask : SetValue(e.Value);

    private Task OnInput(ChangeEventArgs e)
        => Immediate ? SetValue(e.Value) : Task.CompletedTask;

    private async Task SetValue(object? raw)
    {
        if (Disabled || _disposed) return;
        if (BindConverter.TryConvertTo<T>(
                raw,
                CultureInfo.InvariantCulture,
                out var converted))
        {
            await ValueChanged.InvokeAsync(converted);
            _field.Notify();
        }
        else _field.Notify("Informe um número válido.");
    }
}
