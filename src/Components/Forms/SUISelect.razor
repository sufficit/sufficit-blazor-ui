@using System.Globalization
@using Sufficit.Blazor.UI.Utilities
@using Microsoft.AspNetCore.Components.Web
@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@typeparam TValue
@implements ISUISelectRegistry
@implements IAsyncDisposable
@inject IJSRuntime JS

<CascadingValue Value="(ISUISelectRegistry)this" IsFixed="true">
    <div class="@Classname" style="@Style" @onfocusin="() => { _focusVersion++; }" @onfocusout="OnFocusOutAsync">
        @if (LabelContent is not null)
        {
            <label id="@LabelId" class="sui-field__label" for="@EffectiveId">@LabelContent</label>
        }
        else if (!string.IsNullOrWhiteSpace(Label))
        {
            <label id="@LabelId" class="sui-field__label" for="@EffectiveId">@Label</label>
        }

        <div class="sui-select__control">
            <button type="button"
                    @ref="_triggerElement"
                    id="@EffectiveId"
                    class="sui-select__trigger"
                    role="combobox"
                    aria-haspopup="listbox"
                    aria-expanded="@(_open ? "true" : "false")"
                    aria-controls="@MenuId"
                    aria-labelledby="@LabelledBy"
                    aria-describedby="@DescribedBy"
                    aria-invalid="@(Invalid || EffectiveErrorText is not null ? "true" : "false")"
                    aria-errormessage="@ErrorMessageId"
                    aria-activedescendant="@ActiveDescendantId"
                    disabled="@Disabled"
                    @onclick="Toggle"
                    @onkeydown="OnKeyDown"
                    @attributes="AdditionalAttributes">
                @if (!string.IsNullOrWhiteSpace(StartIcon))
                {
                    <span class="sui-select__icon sui-color-@SUIClassBuilder.Slug(IconColorValue)" aria-hidden="true">
                        <SUIIcon Name="@StartIcon" Size="18" />
                    </span>
                }
                <span class="sui-select__value">
                    @if (SelectedItem is { } selected)
                    {
                        @if (!string.IsNullOrWhiteSpace(selected.Icon))
                        {
                            <span class="sui-select__icon sui-color-@SUIClassBuilder.Slug(selected.IconColorValue)" aria-hidden="true">
                                <SUIIcon Name="@selected.Icon" Size="18" />
                            </span>
                        }
                        <span class="sui-select__text">@selected.ChildContent</span>
                    }
                    else if (ShowPlaceholder)
                    {
                        <span class="sui-select__placeholder">@Placeholder</span>
                    }
                </span>
                @if (!string.IsNullOrWhiteSpace(EndIcon))
                {
                    <span class="sui-select__icon sui-color-@SUIClassBuilder.Slug(IconColorValue)" aria-hidden="true">
                        <SUIIcon Name="@EndIcon" Size="18" />
                    </span>
                }
                <span class="sui-select__indicator" aria-hidden="true"></span>
            </button>

            @if (_items.Count > 0)
            {
                <div @ref="_menuElement"
                     id="@MenuId"
                     class="@MenuClass"
                     role="listbox"
                     tabindex="-1"
                     aria-labelledby="@LabelledBy"
                     popover="manual">
                    @for (var index = 0; index < _items.Count; index++)
                    {
                        var item = _items[index];
                        <button type="button"
                                id="@OptionId(index)"
                                class="@OptionClass(index)"
                                role="option"
                                tabindex="-1"
                                aria-selected="@(IsSelected(item) ? "true" : "false")"
                                aria-disabled="@(item.Disabled ? "true" : "false")"
                                disabled="@item.Disabled"
                                @onclick="() => SelectAsync(item)"
                                @onpointerdown:preventDefault="true"
                                @onmousedown:preventDefault="true">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <span class="sui-select__icon sui-color-@SUIClassBuilder.Slug(item.IconColorValue)" aria-hidden="true">
                                    <SUIIcon Name="@item.Icon" Size="18" />
                                </span>
                            }
                            <span class="sui-select__text">@item.ChildContent</span>
                        </button>
                    }
                </div>
            }
        </div>

        @* The trigger is a button, which submits nothing: a plain HTML form
           only sees the selection through this proxy. *@
        @if (!string.IsNullOrWhiteSpace(Name))
        {
            <input type="hidden" name="@Name" value="@FormValue" disabled="@Disabled" />
        }

        @if (HelperContent is not null)
        {
            <span id="@HelperId" class="sui-field__helper">@HelperContent</span>
        }
        else if (!string.IsNullOrWhiteSpace(HelperText))
        {
            <span id="@HelperId" class="sui-field__helper">@HelperText</span>
        }

        @if (!string.IsNullOrWhiteSpace(WarningText))
        {
            <span id="@WarningId" class="sui-field__warning">@WarningText</span>
        }

        @if (!string.IsNullOrWhiteSpace(EffectiveErrorText))
        {
            <span id="@ErrorId" class="sui-field__error">@EffectiveErrorText</span>
        }

        @* The items register through the cascade; this source remains inert in the DOM. *@
        <div class="sui-select__items-source" hidden aria-hidden="true">@ChildContent</div>
    </div>
</CascadingValue>
