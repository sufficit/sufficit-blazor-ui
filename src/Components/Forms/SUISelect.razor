@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@namespace Sufficit.Blazor.UI.Components
@typeparam T
@implements ISUISelectRegistry
@implements IAsyncDisposable
@inject IJSRuntime JS

<CascadingValue Value="(ISUISelectRegistry)this" IsFixed="true">
    <div class="@Classname" @onfocusout="OnFocusOutAsync">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label id="@LabelId" class="sui-field__label" for="@EffectiveId">@Label</label>
        }

        <div class="sui-select__control">
            <button type="button"
                    @ref="_triggerElement"
                    id="@EffectiveId"
                    class="sui-select__trigger"
                    role="combobox"
                    aria-haspopup="listbox"
                    aria-expanded="@(_open ? "true" : "false")"
                    aria-controls="@MenuId"
                    aria-labelledby="@LabelledBy"
                    aria-describedby="@DescribedBy"
                    aria-invalid="@(Invalid ? "true" : "false")"
                    aria-errormessage="@ErrorMessageId"
                    aria-activedescendant="@ActiveDescendantId"
                    disabled="@Disabled"
                    @onclick="Toggle"
                    @onkeydown="OnKeyDown"
                    @attributes="UserAttributes">
                <span class="sui-select__value">
                    @if (SelectedItem is { } selected)
                    {
                        @selected.ChildContent
                    }
                    else if (ShowPlaceholder)
                    {
                        <span class="sui-select__placeholder">@Placeholder</span>
                    }
                </span>
                <span class="sui-select__indicator" aria-hidden="true"></span>
            </button>

            @if (_items.Count > 0)
            {
                <div @ref="_menuElement"
                     id="@MenuId"
                     class="@MenuClass"
                     role="listbox"
                     aria-labelledby="@LabelledBy"
                     popover="manual"
                     style="@MenuStyle">
                    @for (var index = 0; index < _items.Count; index++)
                    {
                        var item = _items[index];
                        <button type="button"
                                id="@OptionId(index)"
                                class="@OptionClass(index)"
                                role="option"
                                aria-selected="@(IsSelected(item) ? "true" : "false")"
                                aria-disabled="@(item.Disabled ? "true" : "false")"
                                disabled="@item.Disabled"
                                @onclick="() => SelectAsync(item)"
                                @onmousedown:preventDefault="true">
                            @item.ChildContent
                        </button>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(HelperText))
        {
            <span id="@HelperId" class="sui-field__helper">@HelperText</span>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <span id="@ErrorId" class="sui-field__error">@ErrorText</span>
        }

        @* The items register through the cascade; this source remains inert in the DOM. *@
        <div class="sui-select__items-source" hidden aria-hidden="true">@ChildContent</div>
    </div>
</CascadingValue>
