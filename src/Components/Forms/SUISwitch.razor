@implements IDisposable
@namespace Sufficit.Blazor.UI.Components

<label class="@Classname" @attributes="AdditionalAttributes">
    <input type="checkbox" class="sui-switch__input"
           checked="@Value"
           @onchange="OnChanged"
           disabled="@Disabled" />
    <span class="sui-switch__track" aria-hidden="true"></span>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="sui-switch__label">@Label</span>
    }
</label>

@if (EffectiveErrorText is not null)
{
    <span class="sui-field__error" role="alert">@EffectiveErrorText</span>
}

@code {
    public void Dispose() => _field.Dispose();

    protected override void OnParametersSet() => _field.Configure(FormContext, ValueExpression, () => _ = InvokeAsync(StateHasChanged));

    [CascadingParameter] private Microsoft.AspNetCore.Components.Forms.EditContext? FormContext { get; set; }
    private readonly SUIFieldBinding<bool> _field = new();
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? ValueExpression { get; set; }
    private string? EffectiveErrorText => _field.Error;

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    /// <summary>Color when on: "primary" (default), "success", etc.</summary>
    [Parameter, Obsolete("Use ColorValue. The object bridge will be removed in v2.0.0.")]
    public object? Color { get; set; } = SUIColor.Primary;

    [Parameter]
    public SUIColor? ColorValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string Classname
        => SUIClassBuilder.Default("sui-switch")
            .AddClass($"sui-switch--{SUIClassBuilder.Slug(EffectiveColor)}")
            .AddClass("sui-switch--on", Value)
            .AddClass(Class)
            .Build();

    private async Task OnChanged(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value is true);
        _field.Notify();
    }

#pragma warning disable CS0618
    private object EffectiveColor => ColorValue ?? Color ?? SUIColor.Primary;
#pragma warning restore CS0618
}
