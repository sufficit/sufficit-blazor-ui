@implements IDisposable
@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@typeparam T

<div class="@Classname" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="sui-field__label" for="@EffectiveId">@Label</label>
    }
    @if (Multiline)
    {
        <textarea @ref="_inputElement"
                  class="sui-field__input sui-field__input--multiline"
                  id="@EffectiveId"
                  name="@Name"
                  rows="@EffectiveRows"
                  @onchange="OnChanged"
                  @oninput="OnInput"
                  placeholder="@Placeholder"
                  maxlength="@MaxLength"
                  disabled="@Disabled"
                  aria-describedby="@DescribedBy"
                  aria-invalid="@(HasError ? "true" : null)"
                  aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
                  @attributes="AdditionalAttributes">@Value</textarea>
    }
    else
    {
        <div class="sui-text-field__control">
            <input @ref="_inputElement" class="@InputClassname"
                   id="@EffectiveId"
                   name="@Name"
                   type="@InputType"
                   value="@(InputValue)"
                   @onchange="OnChanged"
                   @oninput="OnInput"
                   placeholder="@Placeholder"
                   maxlength="@MaxLength"
                   disabled="@Disabled"
                   aria-describedby="@DescribedBy"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
                   @attributes="AdditionalAttributes" />
            @if (CanClear)
            {
                <button type="button"
                        class="sui-text-field__clear"
                        title="@ClearText"
                        aria-label="@ClearText"
                        @onmousedown:preventDefault="true"
                        @onclick="ClearAsync">
                    <SUIIcon Name="x" Size="16" />
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(AdornmentIcon))
            {
                <span class="@(CanClear ? "sui-text-field__adornment sui-text-field__adornment--with-clear" : "sui-text-field__adornment")"
                      aria-hidden="true">
                    <SUIIcon Name="@AdornmentIcon" Size="18" />
                </span>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <span id="@HelperId" class="sui-field__helper">@HelperText</span>
    }
    @if (FormContext is not null || !string.IsNullOrWhiteSpace(EffectiveErrorText))
    {
        <span id="@ErrorId" class="sui-field__error sui-field__error--reserve">@EffectiveErrorText</span>
    }
</div>
