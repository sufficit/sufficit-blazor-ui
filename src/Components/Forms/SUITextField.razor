@implements IDisposable
@namespace Sufficit.Blazor.UI.Components
@typeparam T

<div class="@Classname">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="sui-field__label" for="@EffectiveId">@Label</label>
    }
    @if (Multiline)
    {
        <textarea @ref="_inputElement"
                  class="sui-field__input sui-field__input--multiline"
                  id="@EffectiveId"
                  name="@Name"
                  rows="@EffectiveRows"
                  style="height:auto;min-height:108px;padding:var(--sui-space-3);resize:vertical"
                  @onchange="OnChanged"
                  @oninput="OnInput"
                  placeholder="@Placeholder"
                  maxlength="@MaxLength"
                  disabled="@Disabled"
                  aria-describedby="@DescribedBy"
                  aria-invalid="@(HasError ? "true" : null)"
                  aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
                  @attributes="UserAttributes">@Value</textarea>
    }
    else
    {
        <div class="sui-text-field__control" style="position:relative">
            <input @ref="_inputElement" class="sui-field__input"
                   id="@EffectiveId"
                   name="@Name"
                   type="@InputType"
                   value="@(InputValue)"
                   style="@InputPaddingStyle"
                   @onchange="OnChanged"
                   @oninput="OnInput"
                   placeholder="@Placeholder"
                   maxlength="@MaxLength"
                   disabled="@Disabled"
                   aria-describedby="@DescribedBy"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-errormessage="@(!string.IsNullOrWhiteSpace(EffectiveErrorText) ? ErrorId : null)"
                   @attributes="UserAttributes" />
            @if (CanClear)
            {
                <button type="button"
                        class="sui-text-field__clear"
                        style="position:absolute;inset-block-start:50%;inset-inline-end:0;display:inline-flex;align-items:center;justify-content:center;width:2.75rem;height:100%;padding:0;color:var(--sui-text-secondary);background:transparent;border:0;cursor:pointer;transform:translateY(-50%)"
                        title="@ClearText"
                        aria-label="@ClearText"
                        @onmousedown:preventDefault="true"
                        @onclick="ClearAsync">
                    <SUIIcon Name="x" Size="16" />
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(AdornmentIcon))
            {
                <span class="@(CanClear ? "sui-text-field__adornment sui-text-field__adornment--with-clear" : "sui-text-field__adornment")"
                      style="@AdornmentStyle"
                      aria-hidden="true">
                    <SUIIcon Name="@AdornmentIcon" Size="18" />
                </span>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <span id="@HelperId" class="sui-field__helper">@HelperText</span>
    }
    @if (FormContext is not null || !string.IsNullOrWhiteSpace(EffectiveErrorText))
    {
        <span id="@ErrorId" class="sui-field__error" style="min-height:1.3em">@EffectiveErrorText</span>
    }
</div>
