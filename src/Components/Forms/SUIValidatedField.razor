@namespace Sufficit.Blazor.UI.Components
@typeparam TValue
@implements IDisposable

@ChildContent?.Invoke(_error)

@code {
    private readonly Guid _id = Guid.NewGuid();
    private SUIValidationScope? _registered;
    private TValue? _priorValue;
    private bool _initialized;
    private string? _error;
    private (bool Required, string Text, bool Disabled, Delegate? Validator, Delegate? AsyncValidator) _priorRules;
    private long _generation;
    private bool _disposed;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _pending;

    [CascadingParameter] private SUIValidationScope? Scope { get; set; }
    /// <summary>Current field value; observing it never changes the consumer model.</summary>
    [Parameter] public TValue? Value { get; set; }
    /// <summary>Whether null or empty text is invalid.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Localized message for a missing required value.</summary>
    [Parameter] public string RequiredText { get; set; } = "Preencha este campo.";
    /// <summary>Skips validation while the field is disabled.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Typed synchronous rule; return null for a valid value.</summary>
    [Parameter] public Func<TValue?, string?>? Validator { get; set; }
    /// <summary>Optional typed asynchronous rule, run after the synchronous rule passes.</summary>
    [Parameter] public Func<TValue?, CancellationToken, Task<string?>>? AsyncValidator { get; set; }
    /// <summary>Render the field using the supplied error text, e.g. SUITextField ErrorText.</summary>
    [Parameter] public RenderFragment<string?>? ChildContent { get; set; }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var scopeChanged = !ReferenceEquals(_registered, Scope);
        if (scopeChanged)
        {
            _registered?.Unregister(_id);
            _registered = Scope;
            Scope?.Register(_id, Validate);
        }
        var rules = (Required, RequiredText, Disabled, (Delegate?)Validator, (Delegate?)AsyncValidator);
        var touched = _initialized && !EqualityComparer<TValue?>.Default.Equals(_priorValue, Value);
        if (_initialized && !scopeChanged && !touched && rules.Equals(_priorRules)) return;
        _priorRules = rules;
        _priorValue = Value;
        _initialized = true;
        await Validate(touched || Scope?.Submitted == true, CancellationToken.None);
    }

    private async Task<bool> Validate(bool showErrors, CancellationToken token)
    {
        var generation = ++_generation;
        _pending?.Cancel();
        var request = CancellationTokenSource.CreateLinkedTokenSource(token, _lifetime.Token);
        _pending = request;
        try
        {
            string? error = null;
            if (!Disabled)
            {
                error = Required && (Value is null || Value is string text && string.IsNullOrWhiteSpace(text)) ? RequiredText : Validator?.Invoke(Value);
                if (error == null && AsyncValidator != null)
                {
                    _registered?.SetValidity(_id, false, showErrors);
                    error = await AsyncValidator(Value, request.Token);
                }
            }
            if (_disposed || generation != _generation || request.IsCancellationRequested) return false;
            _error = showErrors ? error : null;
            _registered?.SetValidity(_id, error == null, showErrors);
            await InvokeAsync(StateHasChanged);
            return error == null;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { return false; }
        finally
        {
            if (ReferenceEquals(_pending, request)) _pending = null;
            request.Dispose();
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _generation++;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _registered?.Unregister(_id);
    }
}
