@namespace Sufficit.Blazor.UI.Components

<div class="@Classname" style="@Style" @attributes="Attributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="sui-card__header-icon" aria-hidden="true">
            <SUIIcon Name="@Icon" Size="20" />
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
    {
        <div class="sui-card__header-copy">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h2 class="sui-card__header-title">@Title</h2>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="sui-card__header-description">@Description</p>
            }
        </div>
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }

    @if (Meta is not null)
    {
        <div class="sui-card__header-meta">@Meta</div>
    }

    @if (Actions is not null)
    {
        <div class="sui-card__header-actions">@Actions</div>
    }
</div>

@code {
    /// <summary>Forward unmatched attributes to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?>? Attributes { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    /// <summary>Optional SUI icon name shown before the heading.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Optional semantic heading for the card.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Optional supporting copy shown below the title.</summary>
    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional metadata placed between the heading and actions.</summary>
    [Parameter]
    public RenderFragment? Meta { get; set; }

    /// <summary>Optional actions aligned to the end of the header.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private string Classname
        => SUIClassBuilder.Default("sui-card__header")
            .AddClass(Class)
            .Build();
}
