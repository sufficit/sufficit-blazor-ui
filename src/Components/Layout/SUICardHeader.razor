@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div class="@Classname" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="sui-card__header-icon" aria-hidden="true">
            <SUIIcon Name="@Icon" Size="20" />
        </span>
    }

    @if (CardHeaderAvatar is not null)
    {
        <div class="sui-card__header-avatar">@CardHeaderAvatar</div>
    }

    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description) || CardHeaderContent is not null)
    {
        <div class="sui-card__header-copy">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h2 class="sui-card__header-title">@Title</h2>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="sui-card__header-description">@Description</p>
            }
            @CardHeaderContent
        </div>
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }

    @if ((Meta ?? MetaContent) is not null)
    {
        <div class="sui-card__header-meta">@(Meta ?? MetaContent)</div>
    }

    @if (Actions is not null || CardHeaderActions is not null)
    {
        <div class="sui-card__header-actions">
            @Actions
            @CardHeaderActions
        </div>
    }
</div>

@code {
    /// <summary>Optional SUI icon name shown before the heading.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Optional semantic heading for the card.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Optional supporting copy shown below the title.</summary>
    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional metadata placed between the heading and actions.</summary>
    [Parameter]
    public RenderFragment? Meta { get; set; }
    /// <summary>
    /// Same slot as <see cref="Meta"/> under a name Razor can parse. Markup that
    /// writes &lt;Meta&gt; is read as the void HTML meta element and leaves the
    /// card unbalanced; write &lt;MetaContent&gt; instead.
    /// </summary>
    [Parameter]
    public RenderFragment? MetaContent { get; set; }

    /// <summary>Optional actions aligned to the end of the header.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Compatibility slot for consumers that still use MudCardHeader's named
    /// fragment convention while the surrounding card is already SUI-based.
    /// </summary>
    [Parameter]
    public RenderFragment? CardHeaderAvatar { get; set; }

    /// <summary>Compatibility slot for legacy card header content.</summary>
    [Parameter]
    public RenderFragment? CardHeaderContent { get; set; }

    /// <summary>Compatibility slot for legacy card header actions.</summary>
    [Parameter]
    public RenderFragment? CardHeaderActions { get; set; }

    /// <summary>Legacy alias for <see cref="SUIComponentBase.AdditionalAttributes"/>.</summary>
    [Parameter, Obsolete("Use AdditionalAttributes instead; this alias will be removed in the next breaking release.")]
    public Dictionary<string, object?>? Attributes { get; set; }

    protected override void OnParametersSet()
    {
#pragma warning disable CS0618 // deliberate bridge for the obsolete parameter
        if (Attributes is { Count: > 0 })
            MergeLegacyAttributes(Attributes);
#pragma warning restore CS0618
    }

    private string Classname
        => SUIClassBuilder.Default("sui-card__header")
            .AddClass(Class)
            .Build();
}
