@namespace Sufficit.Blazor.UI.Components

<div class="@Classname" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Max width bucket: "sm", "md", "lg", "xl", "xxl", "false" (full). Default "lg".</summary>
    [Parameter]
    public string MaxWidth { get; set; } = "lg";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Unmatched attributes (id, data-*, aria-*, style, ...) forwarded to the root
    /// div. Without this, any such attribute throws InvalidOperationException at
    /// render time — a page-level crash in the consumer.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private string Classname
        => SUIClassBuilder.Default("sui-container")
            .AddClass($"sui-container--{MaxWidth?.ToLowerInvariant()}", !string.IsNullOrWhiteSpace(MaxWidth))
            .AddClass(Class)
            .Build();
}
