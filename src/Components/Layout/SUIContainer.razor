@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div class="@Classname" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Max width bucket: "sm", "md", "lg", "xl", "xxl", "false" (full). Default "lg".</summary>
    [Parameter]
    public string MaxWidth { get; set; } = "lg";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Unmatched attributes (id, data-*, ...) and Style come from SUIComponentBase
    // and are forwarded to the root div. Regression guard: a consumer page once
    // passed id="..." and Blazor threw InvalidOperationException at render time.

    private string Classname
        => SUIClassBuilder.Default("sui-container")
            .AddClass($"sui-container--{MaxWidth?.ToLowerInvariant()}", !string.IsNullOrWhiteSpace(MaxWidth))
            .AddClass(Class)
            .Build();
}
