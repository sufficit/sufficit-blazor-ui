@namespace Sufficit.Blazor.UI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (ShowBackdrop && _isCompact && Open)
{
    <div class="sui-drawer-backdrop"
         aria-hidden="true"
         @onclick="CloseFromBackdropAsync"></div>
}

<aside @ref="_drawerElement"
       id="@Id"
       class="@Classname"
       style="@StyleValue"
       role="@Role"
       aria-label="@AriaLabel"
       aria-modal="@AriaModal"
       aria-hidden="@AriaHidden"
       tabindex="@TabIndex"
       @attributes="AdditionalAttributes">
    @if (_isCompact && ShowCloseButton)
    {
        <div class="sui-drawer__header">
            <SUIText Typo="SUITypo.subtitle1" Color="SUIColor.Inherit" Class="sui-drawer__title">
                @Title
            </SUIText>
            <SUIIconButton Icon="@SUIIcons.Close"
                           Title="@CloseLabel"
                           ColorValue="SUIColor.Inherit"
                           SizeValue="SUISize.Large"
                           EdgeValue="SUIEdge.True"
                           OnClick="CloseAsync"
                           data-sui-drawer-close="true" />
        </div>
    }

    <div class="sui-drawer__content">
        @ChildContent
    </div>
</aside>
