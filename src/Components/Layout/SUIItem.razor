@namespace Sufficit.Blazor.UI.Components

<div class="@Classname">
    @ChildContent
</div>

@code {
    /// <summary>Columns (1–12) at the smallest breakpoint. Default 12.</summary>
    [Parameter]
    public int Xs { get; set; } = 12;

    /// <summary>Columns from the <c>sm</c> breakpoint up; inherits <see cref="Xs"/> when null.</summary>
    [Parameter]
    public int? Sm { get; set; }

    /// <summary>Columns from the <c>md</c> breakpoint up.</summary>
    [Parameter]
    public int? Md { get; set; }

    /// <summary>Columns from the <c>lg</c> breakpoint up.</summary>
    [Parameter]
    public int? Lg { get; set; }

    /// <summary>Columns from the <c>xl</c> breakpoint up.</summary>
    [Parameter]
    public int? Xl { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Classname
        => SUIClassBuilder.Default("sui-item")
            .AddClass($"sui-item--xs-{Clamp(Xs)}")
            .AddClass($"sui-item--sm-{Clamp(Sm)}", Sm.HasValue)
            .AddClass($"sui-item--md-{Clamp(Md)}", Md.HasValue)
            .AddClass($"sui-item--lg-{Clamp(Lg)}", Lg.HasValue)
            .AddClass($"sui-item--xl-{Clamp(Xl)}", Xl.HasValue)
            .AddClass(Class)
            .Build();

    private static int Clamp(int? v) => v is null ? 12 : v.Value is < 1 or > 12 ? 12 : v.Value;
}
