@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

<div class="@Classname" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Drawer open state (two-way bindable).</summary>
    [Parameter]
    public bool DrawerOpen { get; set; }

    [Parameter]
    public EventCallback<bool> DrawerOpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Classname
        => SUIClassBuilder.Default("sui-layout")
            .AddClass("sui-layout--drawer-open", DrawerOpen)
            .AddClass(Class)
            .Build();
}
