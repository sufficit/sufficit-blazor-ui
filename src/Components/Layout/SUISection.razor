@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

@if (Flat)
{
    @* Built from the stack and text classes: the only new CSS is the divider rule. *@
    <section class="@Classname" style="@Style" aria-labelledby="@TitleId" @attributes="AdditionalAttributes">
        <div class="sui-stack sui-stack--row sui-stack--ai-center sui-stack--jc-between">
            <h2 id="@TitleId" class="sui-text sui-text--overline sui-section__title">@Title</h2>
            @Actions
        </div>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="sui-text sui-text--caption sui-section__title">@Description</p>
        }
        @if (ChildContent is not null)
        {
            <SUIStack Spacing="@EffectiveContentSpacing">
                @ChildContent
            </SUIStack>
        }
    </section>
}
else
{
    <section class="@Classname" style="@Style" @attributes="AdditionalAttributes">
        <SUICard Elevation="@Elevation">
            <SUICardHeader Icon="@Icon" Title="@Title" Description="@Description">
                <Actions>@Actions</Actions>
            </SUICardHeader>
            @if (ChildContent is not null)
            {
                <SUICardContent>
                    <SUIStack Spacing="@EffectiveContentSpacing">
                        @ChildContent
                    </SUIStack>
                </SUICardContent>
            }
        </SUICard>
    </section>
}

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Defines the vertical rhythm between direct content blocks using the Sufficit
    /// spacing scale. Defaults to 4 (16px); use 0 only when the consumer owns the
    /// complete internal layout.
    /// </summary>
    [Parameter] public int ContentSpacing { get; set; } = 4;

    /// <summary>
    /// Glues this section to the previous attached one: no gap between them and a
    /// flat seam (no rounded corners, single shared border), so a run of attached
    /// sections reads as one block with internal divisions. They remain separate
    /// sections for assistive technology and for their own headers.
    /// </summary>
    [Parameter] public bool Attached { get; set; }

    /// <summary>
    /// Spacing token index (0-6) separating this section from the previous one.
    /// Defaults to 4 (16px) so stacked sections never touch by accident; use 0 to
    /// remove the gap. Ignored while <see cref="Attached"/> is set.
    /// </summary>
    [Parameter] public int? Gap { get; set; }

    [Parameter] public int Elevation { get; set; }

    /// <summary>
    /// Renders without the card: an overline title above the content, for settings
    /// lists and narrow panels where nested cards would crowd the space. Stacked
    /// flat sections are divided by a rule with the same breathing room above and
    /// below it (<see cref="Gap"/>), so the divider never touches the controls.
    /// <see cref="Icon"/>, <see cref="Elevation"/> and <see cref="Attached"/> do not apply.
    /// </summary>
    [Parameter] public bool Flat { get; set; }

    /// <summary>
    /// Marks the section as consequential: <see cref="SUITone.Danger"/> for loss
    /// (delete, revoke) and <see cref="SUITone.Warning"/> for interruption. Only the
    /// border and the title take the tone color; the copy stays neutral and the
    /// section keeps its size and position, since color distinguishes but does not
    /// create hierarchy. Null (default) and the other tones render the plain section.
    /// </summary>
    [Parameter] public SUITone? ToneValue { get; set; }

    private readonly string _titleId = $"sui-section-{Guid.NewGuid():N}";
    private string TitleId => _titleId;

    private string Classname
        => SUIClassBuilder.Default("sui-section")
            .AddClass("sui-stack sui-section--flat", Flat)
            .AddClass("sui-section--attached", Attached && !Flat)
            .AddClass($"sui-section--gap-{EffectiveGap}", EffectiveGap is not null)
            .AddClass($"sui-section--tone sui-section--{SUIClassBuilder.Slug(ToneValue)}", ToneValue is SUITone.Danger or SUITone.Warning)
            .AddClass(Class)
            .Build();

    // A class, not an inline --sui-section-gap: a style attribute is ignored under a
    // CSP with style-src-attr 'none'. Attached means glued to the previous
    // section, so the gap is zero by definition; space-0 does not exist in the
    // scale, so a requested 0 means "no gap".
    private int? EffectiveGap
        => (Attached && !Flat) || Gap is 0 ? 0 : Gap is int gap ? Math.Clamp(gap, 1, 6) : null;

    private int EffectiveContentSpacing => Math.Clamp(ContentSpacing, 0, 6);
}
