@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase

@if (IsRootRail)
{
    @* Rail mode: top-level group = icon trigger + floating glass flyout. *@
    <div class="@Classname sui-rail-group"
         style="@Style"
         @attributes="AdditionalAttributes"
         @onpointerenter="EnterRail"
         @onpointerleave="LeaveRail">
        <button type="button"
                class="sui-rail-trigger @(_flyoutOpen ? "is-open" : "")"
                aria-haspopup="menu"
                aria-expanded="@_flyoutOpen.ToString().ToLowerInvariant()"
                aria-label="@Title"
                disabled="@_navigationContext.Disabled"
                @onclick="ToggleFlyout"
                @onfocusin="OpenFlyout">
            @RenderTrigger()
        </button>
        <div class="sui-popover sui-popover--rail sui-rail-flyout @(_flyoutOpen ? "is-open" : "")"
             @ref="_flyoutElement"
             role="menu"
             aria-label="@Title"
             hidden="@(!_flyoutOpen)"
             @onpointerenter="EnterFlyout"
             @onpointerleave="LeaveFlyout"
             @onfocusin="OpenFlyout">
            <div class="sui-rail-flyout-inner">
                <div class="sui-rail-flyout-head">
                    @if (TitleContent is not null)
                    {
                        @TitleContent
                    }
                    else
                    {
                        <span class="sui-rail-flyout-title">@Title</span>
                        @if (!string.IsNullOrWhiteSpace(SubTitle))
                        {
                            <span class="sui-rail-flyout-subtitle">@SubTitle</span>
                        }
                    }
                </div>
                <CascadingValue Value="@RailFlyoutContext">
                    <CascadingValue Value="true" Name="SufficitRailFlyoutMode" IsFixed="true">
                        <CascadingValue Value="_childAccordionScope" IsFixed="true">
                            <div class="sui-nav sui-nav--nested">
                                @ChildContent
                            </div>
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </div>
        </div>
    </div>
}
else
{
<nav @attributes="AdditionalAttributes"
     class="@Classname"
     aria-disabled="@(_navigationContext.Disabled ? "true" : null)"
     style="@Style"
     aria-label="@Title">
    <button @onclick="ExpandedToggleAsync"
            tabindex="@ButtonTabIndex"
            class="@ButtonClassname"
            disabled="@_navigationContext.Disabled"
            aria-controls="@_navigationContext.MenuId"
            aria-expanded="@_navigationContext.Expanded.ToString().ToLowerInvariant()">
        @RenderTrigger()
        <span class="sui-nav-link__text">
            @if (TitleContent is not null)
            {
                @TitleContent
            }
            else
            {
                <span class="sui-nav-link__title">@Title</span>
                @if (!string.IsNullOrWhiteSpace(SubTitle))
                {
                    <span class="sui-nav-link__subtitle">@SubTitle</span>
                }
            }
        </span>
        @if (!HideExpandIcon)
        {
            <span class="@ExpandIconClassname">
                @SUIClickLoading.Glyph(ExpandIcon)
            </span>
        }
    </button>
    <div class="sui-collapse @(_navigationContext.Expanded ? "is-expanded" : "") @(CollapseCssomStyle is null ? "" : "sui-collapse--capped")"
         id="@_navigationContext.MenuId"
         data-sui-style="@CollapseCssomStyle"
         aria-hidden="@((_navigationContext.Expanded is false).ToString().ToLowerInvariant())">
        <div class="sui-collapse__inner">
            <CascadingValue Value="@_navigationContext">
                <CascadingValue Value="ChildAccordionScope" IsFixed="true">
                    <div class="sui-nav sui-nav--nested">
                        @ChildContent
                    </div>
                </CascadingValue>
            </CascadingValue>
        </div>
    </div>
</nav>
}

@code {
    // CSSOM via data-sui-style: a style attribute is ignored under style-src-attr 'none'.
    private string? CollapseCssomStyle
        => SUIStyleBuilder.Default().Add("--sui-collapse-max-height", $"{MaxHeight}px", MaxHeight > 0).Build();

    private RenderFragment RenderTrigger() => __builder =>
    {
        if (IconContent is not null)
        {
            @IconContent
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <span class="@IconClassname">
                @SUIClickLoading.Glyph(Icon)
            </span>
        }
        else
        {
            <span class="sui-avatar sui-avatar--sm sui-avatar--outlined sui-color-@IconColor.ToString().ToLowerInvariant()">@GetInitials()</span>
        }
    };
}
