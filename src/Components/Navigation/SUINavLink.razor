@namespace Sufficit.Blazor.UI.Components
@using Microsoft.AspNetCore.Components.Routing
@using Sufficit.Blazor.UI.Utilities

<div @attributes="UserAttributes"
     class="@Classname"
     style="@Style"
     aria-disabled="@IsDisabled">
    @if (RailTooltip is not null)
    {
        <SUITooltip Text="@RailTooltip"
                    Placement="@TooltipPlacement"
                    BackgroundColor="@TooltipBackgroundColor"
                    TextColor="@TooltipTextColor"
                    BorderColor="@TooltipBorderColor"
                    Opacity="@TooltipOpacity"
                    Offset="@TooltipOffset"
                    MaxWidth="@TooltipMaxWidth"
                    ShowDelay="@TooltipShowDelay"
                    HideDelay="@TooltipHideDelay"
                    ShowArrow="@TooltipShowArrow"
                    BorderRadius="@TooltipBorderRadius"
                    Padding="@TooltipPadding"
                    BoxShadow="@TooltipBoxShadow"
                    FontSize="@TooltipFontSize"
                    FontWeight="@TooltipFontWeight"
                    TooltipClass="@TooltipClass"
                    Class="sui-nav-link__tooltip-anchor">
            @RenderInteractive()
        </SUITooltip>
    }
    else
    {
        @RenderInteractive()
    }
</div>

@code {
    [CascadingParameter]
    private SUINavigationContext? ParentNavigationContext { get; set; }

    [CascadingParameter(Name = "SufficitRailMode")]
    private bool RailMode { get; set; }

    [CascadingParameter(Name = "SufficitRailFlyoutMode")]
    private bool RailFlyoutMode { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public bool ForceLoad { get; set; }
    [Parameter] public string ActiveClass { get; set; } = "active";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public SUIColor IconColor { get; set; } = SUIColor.Default;
    [Parameter] public bool IconAsAvatar { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int TabIndex { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public SUITooltipPlacement TooltipPlacement { get; set; } = SUITooltipPlacement.Right;
    [Parameter] public string? TooltipBackgroundColor { get; set; }
    [Parameter] public string? TooltipTextColor { get; set; }
    [Parameter] public string? TooltipBorderColor { get; set; }
    [Parameter] public double TooltipOpacity { get; set; } = .95;
    [Parameter] public int TooltipOffset { get; set; } = 10;
    [Parameter] public int TooltipMaxWidth { get; set; } = 240;
    [Parameter] public int TooltipShowDelay { get; set; } = 220;
    [Parameter] public int TooltipHideDelay { get; set; } = 70;
    [Parameter] public bool TooltipShowArrow { get; set; } = true;
    [Parameter] public string? TooltipBorderRadius { get; set; }
    [Parameter] public string? TooltipPadding { get; set; }
    [Parameter] public string? TooltipBoxShadow { get; set; }
    [Parameter] public string? TooltipFontSize { get; set; }
    [Parameter] public int TooltipFontWeight { get; set; } = 600;
    [Parameter] public string? TooltipClass { get; set; }
    [Parameter] public bool DisableTooltip { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public Dictionary<string, object?> Attributes { get; set; } = new();
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = new();
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool IsDisabled
        => Disabled || ParentNavigationContext is { Disabled: true };

    private string? RailTooltip
        => RailMode && !RailFlyoutMode && !DisableTooltip
            && !string.IsNullOrWhiteSpace(Tooltip ?? Title)
            ? (Tooltip ?? Title)!.Trim()
            : null;

    private string Classname
        => SUIClassBuilder.Default("sui-nav-link")
            .AddClass("sui-nav-link--rail", RailMode && !RailFlyoutMode)
            .AddClass("sui-nav-link--disabled", IsDisabled)
            .AddClass(Class)
            .Build();

    private string LinkClassname
        => SUIClassBuilder.Default("sui-nav-link__row")
            .AddClass("is-disabled", IsDisabled)
            .AddClass($"sui-color-{IconColor.ToString().ToLowerInvariant()}", IconColor != SUIColor.Default)
            .Build();

    private string ForceLoadLinkClassname
        => SUIClassBuilder.Default(LinkClassname)
            .AddClass(ActiveClass, IsForceLoadLinkActive)
            .Build();

    private bool IsForceLoadLinkActive
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Href))
                return false;

            var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            var targetPath = Navigation.ToAbsoluteUri(Href).AbsolutePath.TrimEnd('/');

            if (Match == NavLinkMatch.All)
                return string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase);

            return string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase)
                || currentPath.StartsWith($"{targetPath}/", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string IconClassname
        => SUIClassBuilder.Default("sui-icon sui-nav-link__icon")
            .AddClass($"sui-color-{IconColor.ToString().ToLowerInvariant()}", IconColor != SUIColor.Default)
            .Build();

    private RenderFragment RenderInteractive() => __builder =>
    {
        if (OnClick.HasDelegate && string.IsNullOrWhiteSpace(Href))
        {
            <button type="button"
                    class="@LinkClassname"
                    aria-label="@RailTooltip"
                    disabled="@IsDisabled"
                    @onclick="OnClickHandler">
                @RenderContent()
            </button>
        }
        else if (ForceLoad)
        {
            <a href="@Href"
               class="@ForceLoadLinkClassname"
               @attributes="Attributes"
               aria-label="@RailTooltip"
               aria-disabled="@IsDisabled"
               @onclick:preventDefault="true"
               @onclick="HandleNavigation">
                @RenderContent()
            </a>
        }
        else if (IsDisabled)
        {
            <span class="@LinkClassname"
                  @attributes="Attributes"
                  aria-label="@RailTooltip"
                  aria-disabled="true">
                @RenderContent()
            </span>
        }
        else
        {
            <NavLink href="@Href"
                     class="@LinkClassname"
                     @attributes="Attributes"
                     aria-label="@RailTooltip"
                     Match="@Match"
                     ActiveClass="@ActiveClass"
                     @onclick="HandleNavigation">
                @RenderContent()
            </NavLink>
        }
    };

    private RenderFragment RenderContent() => __builder =>
    {
        if (!string.IsNullOrEmpty(Icon))
        {
            <span class="@IconClassname">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">@((MarkupString)Icon)</svg>
            </span>
        }
        else if (IconAsAvatar || !string.IsNullOrWhiteSpace(Title))
        {
            <span class="sui-avatar sui-avatar--sm sui-avatar--outlined">@GetInitials()</span>
        }

        <span class="sui-nav-link__text">
            @Title
            @ChildContent
        </span>
    };

    private async Task OnClickHandler(MouseEventArgs args)
    {
        if (!IsDisabled && OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    private async Task HandleNavigation(MouseEventArgs args)
    {
        if (IsDisabled)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);

        if (ForceLoad && !string.IsNullOrWhiteSpace(Href))
        {
            Navigation.NavigateTo(Href, forceLoad: true);
            return;
        }
    }

    private string GetInitials()
    {
        if (string.IsNullOrWhiteSpace(Title))
            return string.Empty;

        var result = string.Empty;
        foreach (var part in Title.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.Length > 3)
                result += part[0];
        }

        return result;
    }
}
