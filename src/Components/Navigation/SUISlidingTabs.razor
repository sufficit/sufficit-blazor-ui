@namespace Sufficit.Blazor.UI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Navigation tabs with a sliding pill indicator — smooth tab switching with
   premium micro-interactions, inspired by modern animated tab bars.
   Panels register themselves (like SUITabs); the track renders one button per
   panel and a JS module keeps the indicator glued to the active button. *@

<CascadingValue Value="this">
    <div @ref="_rootElement" class="@Classname" @attributes="AdditionalAttributes">
        <div class="sui-sliding-tabs__scroller">
            <div class="sui-sliding-tabs__track"
                 role="tablist"
                 aria-label="@AriaLabel">
                <span class="sui-sliding-tabs__indicator" aria-hidden="true"></span>
                @for (var i = 0; i < _panels.Count; i++)
                {
                    var idx = i;
                    var panel = _panels[i];
                    <button type="button"
                            @ref="_tabReferences[idx]"
                            id="@TabId(idx)"
                            class="sui-sliding-tab @(idx == ActiveIndex ? "is-active" : null)"
                            role="tab"
                            aria-label="@panel.Text"
                            aria-selected="@(idx == ActiveIndex ? "true" : "false")"
                            aria-controls="@PanelId(idx)"
                            tabindex="@(idx == ActiveIndex ? 0 : -1)"
                            disabled="@panel.Disabled"
                            @onkeydown="args => HandleKeyDown(args, idx)"
                            @onclick="() => Activate(idx)">
                        @if (!string.IsNullOrWhiteSpace(panel.Icon))
                        {
                            <span class="sui-sliding-tab__icon">
                                <SUIIcon Name="@panel.Icon" Size="18" />
                            </span>
                        }
                        <span class="sui-sliding-tab__label">@panel.Text</span>
                    </button>
                }
            </div>
        </div>
        @if (_panels.Count > ActiveIndex)
        {
            var activePanel = _panels[ActiveIndex];
            <div id="@PanelId(ActiveIndex)"
                 class="@PanelClass(activePanel)"
                 role="tabpanel"
                 aria-labelledby="@TabId(ActiveIndex)"
                 tabindex="0">
                @activePanel.ChildContent
            </div>
        }
        @* Instantiate the child SUISlidingTabPanel components so they can
           register with this parent. Their own templates render nothing. *@
        <div hidden aria-hidden="true">@ChildContent</div>
    </div>
</CascadingValue>

@code {
    /// <summary>Accent color of the active tab and its pop animation.</summary>
    [Parameter] public SUIColor ColorValue { get; set; }

    /// <summary>Stretch the track to 100% width; tabs share the space equally.</summary>
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>Center the track when it is narrower than its container.</summary>
    [Parameter] public bool Center { get; set; }

    /// <summary>Always render icons only (labels collapse to aria-label); small screens do this automatically via CSS.</summary>
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>Accessible name for the tab list.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Optional CSS class applied to the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Stable id prefix used to associate tabs and panels.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The <c>SUISlidingTabPanel</c> children that become tabs.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Two-way bound active panel index.</summary>
    [Parameter] public int ActiveIndex { get; set; }

    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> AdditionalAttributes { get; set; } = new();

    private readonly List<SUISlidingTabPanel> _panels = new();
    private readonly string _generatedId = $"sui-sliding-tabs-{Guid.NewGuid():N}";
    private ElementReference[] _tabReferences = [];
    private ElementReference _rootElement;
    private IJSObjectReference? _module;
    private IJSObjectReference? _interop;
    private int? _pendingFocusIndex;

    internal void Register(SUISlidingTabPanel panel)
    {
        if (!_panels.Contains(panel))
        {
            _panels.Add(panel);
            Array.Resize(ref _tabReferences, _panels.Count);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    internal void Unregister(SUISlidingTabPanel panel)
    {
        _panels.Remove(panel);
        Array.Resize(ref _tabReferences, _panels.Count);
        if (ActiveIndex >= _panels.Count && _panels.Count > 0)
            ActiveIndex = _panels.Count - 1;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Activate(int index)
    {
        if (index < 0 || index >= _panels.Count || _panels[index].Disabled)
            return;

        ActiveIndex = index;
        _ = ActiveIndexChanged.InvokeAsync(index);
    }

    private void HandleKeyDown(KeyboardEventArgs args, int index)
    {
        if (_panels.Count == 0 || args.AltKey || args.CtrlKey || args.MetaKey)
            return;

        var nextIndex = args.Key switch
        {
            "ArrowRight" => (index + 1) % _panels.Count,
            "ArrowLeft" => (index - 1 + _panels.Count) % _panels.Count,
            "Home" => 0,
            "End" => _panels.Count - 1,
            _ => -1,
        };

        if (nextIndex < 0)
            return;

        Activate(nextIndex);
        _pendingFocusIndex = nextIndex;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sufficit.Blazor.UI/Components/Navigation/SUISlidingTabs.razor.js?v=1");
            _interop = await _module.InvokeAsync<IJSObjectReference>("initialize", _rootElement);
        }

        if (_module is not null) await _module.InvokeVoidAsync("update", _rootElement);

        if (_pendingFocusIndex is not int index || index >= _tabReferences.Length)
            return;

        _pendingFocusIndex = null;
        await _tabReferences[index].FocusAsync(preventScroll: true);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_interop is not null)
                await _interop.InvokeVoidAsync("dispose");
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // The browser circuit may already be gone during disposal.
        }

        GC.SuppressFinalize(this);
    }

    private string TabsId
        => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id!;

    private string TabId(int index) => $"{TabsId}-tab-{index}";

    private string PanelId(int index) => $"{TabsId}-panel-{index}";

    private static string PanelClass(SUISlidingTabPanel panel)
        => SUIClassBuilder.Default("sui-sliding-tabs__panels")
            .AddClass("sui-sliding-tab-panel")
            .AddClass(panel.Class)
            .Build();

    private string Classname
        => SUIClassBuilder.Default("sui-sliding-tabs")
            .AddClass($"sui-sliding-tabs--{SUIClassBuilder.Slug(ColorValue)}",
                ColorValue is not (SUIColor.Default or SUIColor.Inherit or SUIColor.Surface))
            .AddClass("sui-sliding-tabs--full-width", FullWidth)
            .AddClass("sui-sliding-tabs--center", Center && !FullWidth)
            .AddClass("sui-sliding-tabs--icon-only", IconOnly)
            .AddClass(Class)
            .Build();
}
