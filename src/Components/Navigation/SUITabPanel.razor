@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@implements IDisposable

@* Tab panel: registers with the parent SUITabs (cascaded) on init. Its own
   template renders nothing; the parent shows the active panel's ChildContent. *@

@code {
    [CascadingParameter]
    private SUITabs? _parent { get; set; }

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => _parent?.Register(this);

    public void Dispose() => _parent?.Unregister(this);
}
