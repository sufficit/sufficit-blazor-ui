@namespace Sufficit.Blazor.UI.Components
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Services

<div class="sui-dialog__body">
    <p class="sui-dialog__message">@Message</p>
</div>
<div class="sui-dialog__actions">
    <SUIButton VariantValue="SUIVariant.Outlined" OnClick="Cancel">Cancelar</SUIButton>
    <SUIButton VariantValue="SUIVariant.Filled" ColorValue="SUIColor.Error" OnClick="Confirm">Confirmar</SUIButton>
</div>

@code {
    /// <summary>Set by the dialog service when showing via ConfirmAsync.</summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    [CascadingParameter]
    internal SUIDialogReference? Dialog { get; set; }

    private void Confirm() => Dialog?.Complete(true);
    private void Cancel() => Dialog?.Complete(false);
}
