@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_panel" id="@PanelId" class="sui-context-menu @Class" style="@Style"
     popover="auto" role="menu" aria-label="@Label" tabindex="-1"
     data-sui-defer-escape="@(DeferEscape ? "" : null)" @attributes="AdditionalAttributes"
     @onkeydown="OnKeyDown" @onclick:stopPropagation @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
    @ChildContent
</div>

@code {
    public const string ModulePath = "./_content/Sufficit.Blazor.UI/Components/Overlays/SUIContextMenu.razor.js";

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? MenuId { get; set; }
    [Parameter] public SUIContextMenuRequest? Request { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public bool DeferEscape { get; set; }

    private readonly string _generatedId = $"sui-context-menu-{Guid.NewGuid():N}";
    private string PanelId => MenuId ?? _generatedId;
    private string? _openedId;
    private ElementReference _panel;
    private SUIContextMenuRequest? _renderedRequest;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SUIContextMenu>? _self;
    private bool _disposed;
    private int _generation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ReferenceEquals(Request, _renderedRequest)) return;
        _renderedRequest = Request;
        if (Request is { } request) await OpenAsync(request);
        else await CloseAsync();
    }

    public async Task OpenAsync(SUIContextMenuRequest request)
    {
        if (_disposed) return;
        var generation = ++_generation;
        try
        {
            if (_module is null)
            {
                var loaded = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                if (_disposed || generation != _generation)
                {
                    if (loaded is not null) await loaded.DisposeAsync();
                    return;
                }
                _module = loaded;
            }
            if (_module is null) return;
            _self ??= DotNetObjectReference.Create(this);
            _openedId = PanelId;
            await _module.InvokeVoidAsync("open", _panel, request.AnchorId, request.X, request.Y, _self, generation);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Closes a menu after a caller-owned action. Dismissal callbacks are for browser dismissal.</summary>
    public async Task CloseAsync()
    {
        ++_generation;
        if (_module is null || _openedId is null) return;
        var id = _openedId;
        _openedId = null;
        try { await _module.InvokeVoidAsync("close", id); }
        catch (JSDisconnectedException) { }
    }

    public async Task FocusAsync(string selector)
    {
        if (_module is not null) await _module.InvokeVoidAsync("focus", _panel, selector);
    }

    [JSInvokable]
    public Task NotifyDismissed(int generation) =>
        InvokeAsync(() => !_disposed && generation == _generation ? OnDismiss.InvokeAsync() : Task.CompletedTask);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await CloseAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _self?.Dispose(); }
    }
}
