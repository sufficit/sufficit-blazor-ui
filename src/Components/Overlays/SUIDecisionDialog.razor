@namespace Sufficit.Blazor.UI.Components
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Services

<div class="sui-dialog__body">
    <p class="sui-dialog__message">@Message</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="sui-dialog__description">@Description</p>
    }
</div>
<div class="sui-dialog__actions">
    <SUIButton VariantValue="SUIVariant.Text" OnClick="Cancel">@CancelText</SUIButton>
    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="@SecondaryColor" OnClick="ChooseSecondary">@SecondaryText</SUIButton>
    <SUIButton VariantValue="SUIVariant.Filled" ColorValue="@PrimaryColor" OnClick="ChoosePrimary">@PrimaryText</SUIButton>
</div>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string PrimaryText { get; set; } = "Sim";

    [Parameter]
    public string SecondaryText { get; set; } = "Não";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public SUIColor PrimaryColor { get; set; } = SUIColor.Primary;

    [Parameter]
    public SUIColor SecondaryColor { get; set; } = SUIColor.Default;

    [CascadingParameter]
    internal SUIDialogReference? Dialog { get; set; }

    private void ChoosePrimary() => Dialog?.Complete(true);
    private void ChooseSecondary() => Dialog?.Complete(false);
    private void Cancel() => Dialog?.Complete(null);
}
