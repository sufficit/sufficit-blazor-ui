@namespace Sufficit.Blazor.UI.Components
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Services
@implements IAsyncDisposable
@inject ISUIDialogService DialogService
@inject IJSRuntime JS

@if (_current is not null)
{
    <div class="sui-dialog-overlay" @onclick="DismissAsync">
        <div @ref="_dialogElement"
             @key="_current.Id"
             class="sui-dialog sui-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@TitleId"
             tabindex="-1"
             @onclick:stopPropagation="true">
            <header class="sui-dialog__header">
                <h2 id="@TitleId" class="sui-dialog__title">@_current.Title</h2>
                <button type="button" class="sui-dialog__close" aria-label="Fechar" @onclick="DismissAsync">
                    <SUIIcon Name="x" Size="20" />
                </button>
            </header>
            <CascadingValue Value="@_current.Reference">
                <DynamicComponent Type="@_current.ComponentType" Parameters="@_dialogParameters" />
            </CascadingValue>
        </div>
    </div>
}
