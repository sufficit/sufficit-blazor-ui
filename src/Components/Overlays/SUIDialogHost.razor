@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Services
@implements IAsyncDisposable
@inject ISUIDialogService DialogService
@inject IJSRuntime JS

@if (_current is not null)
{
    <div class="@Classname" style="@Style" @onclick="BackdropClickedAsync" @attributes="AdditionalAttributes">
        <div @ref="_dialogElement"
             @key="_current.Id"
             class="sui-dialog sui-card"
             data-sui-style="@DialogCssomStyle"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@TitleId"
             tabindex="-1"
             @onclick:stopPropagation="true">
            <header class="sui-dialog__header">
                <h2 id="@TitleId" class="sui-dialog__title">
                    @if (!string.IsNullOrWhiteSpace(_current.Options?.Icon))
                    {
                        <SUIIcon Name="@_current.Options.Icon" Size="22" />
                    }
                    @_current.Title
                </h2>
                @if (_current.Options?.ShowCloseButton != false)
                {
                <button type="button" class="sui-dialog__close" aria-label="@CloseLabel" @onclick="DismissAsync">
                    <SUIIcon Name="x" Size="20" />
                </button>
                }
            </header>
            <CascadingValue Value="@_current.Reference">
                <DynamicComponent Type="@_current.ComponentType" Parameters="@_dialogParameters" />
            </CascadingValue>
        </div>
    </div>
}

@code {
    private string Classname => EffectiveClass("sui-dialog-overlay");
}
