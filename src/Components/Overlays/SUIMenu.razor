@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="sui-menu @Class" style="@Style" @attributes="AdditionalAttributes">
    <button @ref="_trigger" type="button" class="sui-menu__trigger" popovertarget="@_id" aria-haspopup="menu" aria-label="@Label" disabled="@Disabled">
        @if(Trigger is not null) { @Trigger }
        else { <SUIIcon Name="@Icon" Size="18" /> @Label }
    </button>
    <div @ref="_panel" id="@_id" popover="auto" role="menu" aria-label="@Label" class="sui-menu__panel">@ChildContent</div>
</div>
@code {
    [Parameter] public string Label {get;set;}="Ações";
    [Parameter] public string Icon {get;set;}="more-vertical";
    [Parameter] public bool Disabled {get;set;}
    [Parameter] public RenderFragment? Trigger {get;set;}
    [Parameter] public RenderFragment? ChildContent {get;set;}
    private readonly string _id="sui-menu-"+Guid.NewGuid().ToString("N");
    private ElementReference _trigger,_panel;
    private IJSObjectReference? _module;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(!firstRender || _disposed)return;
        // Initialization owns its module until connect completes. Disposal can run
        // at either await; a late result must be released, never attached to a dead menu.
        IJSObjectReference? pending=null;
        var connecting=false;
        try {
            pending=await JS.InvokeAsync<IJSObjectReference>("import","./_content/Sufficit.Blazor.UI/Components/Overlays/SUIMenu.razor.js");
            if(_disposed || pending is null)return;
            connecting=true;
            await pending.InvokeVoidAsync("connect",_trigger,_panel);
            if(!_disposed) { _module=pending; pending=null; }
        }
        catch(JSDisconnectedException) { }
        finally { if(pending is not null) await ReleaseAsync(pending,connecting); }
    }
    private async ValueTask ReleaseAsync(IJSObjectReference module,bool disconnect) {
        try { if(disconnect) await module.InvokeVoidAsync("disconnect",_id); }
        catch(JSDisconnectedException) { }
        finally {
            try { await module.DisposeAsync(); }
            catch(JSDisconnectedException) { }
        }
    }
    public async ValueTask DisposeAsync() {
        if(_disposed)return;
        _disposed=true;
        var module=_module; _module=null;
        // A pending initialization releases its own reference in its finally block.
        if(module is not null) await ReleaseAsync(module,true);
    }
}
