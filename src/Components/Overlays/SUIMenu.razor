@namespace Sufficit.Blazor.UI.Components
@inherits SUIComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Sufficit.Blazor.UI.Utilities
@{
    // A variant opts the trigger into the SUIButton visual contract (same classes as SUIButton),
    // so a menu placed next to buttons matches them; without it the compact trigger is kept.
    var triggerClass = VariantValue is { } variant
        ? SUIClassBuilder.Default("sui-btn sui-menu__trigger sui-menu__trigger--button")
            .AddClass($"sui-btn--{SUIClassBuilder.Slug(variant)}")
            .AddClass($"sui-btn--color-{SUIClassBuilder.Slug(ColorValue ?? SUIColor.Primary)}")
            .AddClass($"sui-btn--{SUIClassBuilder.Slug(SizeValue ?? SUISize.Medium)}")
            .Build()
        : "sui-menu__trigger";
}
<div class="sui-menu @Class" style="@Style" @attributes="AdditionalAttributes">
    <button @ref="_trigger" type="button" class="@triggerClass" popovertarget="@_id" aria-haspopup="menu" aria-label="@Label" disabled="@Disabled">
        @if(VariantValue is not null)
        {
            <span class="sui-btn__label">@if(Trigger is not null) { @Trigger } else { @Label }</span>
        }
        else if(Trigger is not null) { @Trigger }
        else { <SUIIcon Name="@Icon" Size="18" /> @Label }
    </button>
    <div @ref="_panel" id="@_id" popover="auto" role="menu" aria-label="@Label" class="sui-menu__panel">@ChildContent</div>
</div>
@code {
    [Parameter] public string Label {get;set;}="Ações";
    [Parameter] public string Icon {get;set;}="more-vertical";
    [Parameter] public bool Disabled {get;set;}
    /// <summary>Renders the trigger as a SUIButton of this variant (Filled, Outlined, Text...).</summary>
    [Parameter] public SUIVariant? VariantValue {get;set;}
    /// <summary>Trigger color when <see cref="VariantValue"/> is set; defaults to Primary.</summary>
    [Parameter] public SUIColor? ColorValue {get;set;}
    /// <summary>Trigger size when <see cref="VariantValue"/> is set; defaults to Medium.</summary>
    [Parameter] public SUISize? SizeValue {get;set;}
    [Parameter] public RenderFragment? Trigger {get;set;}
    [Parameter] public RenderFragment? ChildContent {get;set;}
    private readonly string _id="sui-menu-"+Guid.NewGuid().ToString("N");
    private ElementReference _trigger,_panel;
    private IJSObjectReference? _module;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(!firstRender || _disposed)return;
        // Initialization owns its module until connect completes. Disposal can run
        // at either await; a late result must be released, never attached to a dead menu.
        IJSObjectReference? pending=null;
        var connecting=false;
        try {
            pending=await JS.InvokeAsync<IJSObjectReference>("import","./_content/Sufficit.Blazor.UI/Components/Overlays/SUIMenu.razor.js");
            if(_disposed || pending is null)return;
            connecting=true;
            await pending.InvokeVoidAsync("connect",_trigger,_panel);
            if(!_disposed) { _module=pending; pending=null; }
        }
        catch(JSDisconnectedException) { }
        finally { if(pending is not null) await ReleaseAsync(pending,connecting); }
    }
    private async ValueTask ReleaseAsync(IJSObjectReference module,bool disconnect) {
        try { if(disconnect) await module.InvokeVoidAsync("disconnect",_id); }
        catch(JSDisconnectedException) { }
        finally {
            try { await module.DisposeAsync(); }
            catch(JSDisconnectedException) { }
        }
    }
    public async ValueTask DisposeAsync() {
        if(_disposed)return;
        _disposed=true;
        var module=_module; _module=null;
        // A pending initialization releases its own reference in its finally block.
        if(module is not null) await ReleaseAsync(module,true);
    }
}
