@namespace Sufficit.Blazor.UI.Components
@using Microsoft.AspNetCore.Components
@using Sufficit.Blazor.UI.Services
@implements IDisposable
@inject ISUIDialogService DialogService

@if (_current is not null)
{
    <div class="sui-dialog-overlay" @onclick="Dismiss">
        <div class="sui-dialog sui-card" role="dialog" aria-modal="true" aria-label="@_current.Title" @onclick:stopPropagation="true">
            <header class="sui-dialog__header">
                <h2 class="sui-dialog__title">@_current.Title</h2>
                <button type="button" class="sui-dialog__close" aria-label="Fechar" @onclick="Dismiss">
                    <SUIIcon Name="x" Size="20" />
                </button>
            </header>
            <CascadingValue Value="@_current.Reference">
                <DynamicComponent Type="@_current.ComponentType" Parameters="@_dialogParameters" />
            </CascadingValue>
        </div>
    </div>
}

@code {
    private SUIDialogRequest? _current;
    private IDictionary<string, object?> _dialogParameters = new Dictionary<string, object?>();

    protected override void OnInitialized()
        => DialogService.OnShow += OnShow;

    private void OnShow(SUIDialogRequest request)
    {
        _current = request;
        _dialogParameters = new Dictionary<string, object?>(request.Parameters);
        InvokeAsync(StateHasChanged);
    }

    private void Dismiss()
    {
        if (_current is { } current)
            current.Reference.Complete(null);
        _current = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => DialogService.OnShow -= OnShow;
}
