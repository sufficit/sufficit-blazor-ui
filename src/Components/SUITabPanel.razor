@namespace Sufficit.Blazor.UI.Components
@implements IDisposable

@* Tab panel: registers with the parent SUITabs on render. Content is only
   shown when this panel is the active one (parent renders ChildContent). *@
@{
    if (!_registered)
    {
        _registered = true;
        _parent?.Register(this);
    }
}

@code {
    [CascadingParameter]
    private SUITabs? _parent { get; set; }

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _registered;

    protected override void OnParametersSet()
    {
        // Re-register text changes so the tab list stays in sync.
    }

    public void Dispose()
        => _parent?.Unregister(this);
}
