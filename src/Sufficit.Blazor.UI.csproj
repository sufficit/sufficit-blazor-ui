<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup Label="Sufficit Targeting">
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Packing</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace matches the assembly. The project is self-contained: it has
         no third-party UI framework source or package reference. -->
    <RootNamespace>Sufficit.Blazor.UI</RootNamespace>
    <AssemblyName>Sufficit.Blazor.UI</AssemblyName>
    <!-- The namespace deliberately differs from the legacy Sufficit.Blazor
         package: during migration a project may reference both, and identical
         component namespaces would make every usage ambiguous. -->
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Versioning">
    <!-- Local builds are intentionally non-publishable. Release automation
         overrides Version from a validated vMAJOR.MINOR.PATCH tag. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>local</VersionSuffix>
    <!-- Keep assembly identity stable throughout v1. Package SemVer carries
         feature and patch releases without forcing binding changes. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Product General">
    <Company>SUFFICIT SOLUÇÕES EM TECNOLOGIA DA INFORMAÇÃO</Company>
    <Authors>Hugo Castro de Deco</Authors>
    <ProductName>Sufficit Blazor UI</ProductName>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Pacote NUGET">
    <Name>Sufficit.Blazor.UI</Name>
    <PackageId>Sufficit.Blazor.UI</PackageId>
    <PackageDescription>Sufficit Blazor UI component library (SUI) — autonomous components, theme contract, no third-party UI framework dependency.</PackageDescription>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/sufficit/sufficit-blazor-ui</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sufficit/sufficit-blazor-ui</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/sufficit/sufficit-blazor-ui/main/icon.png</PackageIconUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Label="Sufficit Pacote NUGET Itens">
    <None Include="../icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="../README.md" Pack="True" PackagePath="readme.md" />
  </ItemGroup>

  <ItemGroup Label="Blazor component tooling for .NET 10">
    <!-- The SUI components are plain Blazor: they need only the Razor SDK
         component base packages. Exact servicing versions make restore
         reproducible; Dependabot owns the regular update cadence. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>
