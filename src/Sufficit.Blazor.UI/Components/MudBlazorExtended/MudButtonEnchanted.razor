@namespace MudBlazor
@inherits MudButton
@implements IDisposable
@using MudBlazor.Extensions
@using static MudBlazor.EventUtil


<MudElement @bind-Ref="@_elementReference"
            HtmlTag="@HtmlTag"
            Class="@Classname"
            Style="@Style"
            @attributes="UserAttributes"
            @onclick="OnClickHandler"
            type="@ButtonType.ToString().ToLower()"
            href="@Href"
            target="@Target"
            rel="@GetRel()"
            disabled="@GetDisabledState()"
            ClickPropagation="@GetClickPropagation()">
    <MudOverlay Visible="IsLoading" LightBackground="true" Absolute="true" Class="pt-2">
        <MudProgressCircular Size="Size.Small" Color="@IconColor" Indeterminate="true" />
    </MudOverlay>
    <span class="mud-button-label">
        @if (!string.IsNullOrWhiteSpace(StartIcon))
        {
            <span class="@StartIconClass">
                <MudIcon Disabled="@Disabled" Icon="@StartIcon" Size="@(IconSize ?? Size)" Color="@IconColor" />
            </span>
        }
        @ChildContent
        @if (!string.IsNullOrWhiteSpace(EndIcon))
        {
            <span class="@EndIconClass">
                <MudIcon Disabled="@Disabled" Icon="@EndIcon" Size="@(IconSize ?? Size)" Color="@IconColor" />
            </span>
        }
    </span>
</MudElement>

@code {
    protected bool disabled => GetDisabledState() || IsLoading;

    protected bool IsLoading;

    protected new async Task OnClickHandler(MouseEventArgs ev)
    {
        if (!GetDisabledState())
        {
            IsLoading = true;
            await InvokeAsync(StateHasChanged);

            // normal handling
            await this.AsNonRenderingEventHandler<MouseEventArgs>(base.OnClickHandler).Invoke(ev);
            //await base.OnClickHandler(ev);
            IsLoading = false;

            await InvokeAsync(StateHasChanged);
        }
    }
}