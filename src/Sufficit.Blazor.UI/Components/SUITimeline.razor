@namespace Sufficit.Blazor.UI.Components

<ol class="@Classname">@ChildContent</ol>

@code {
    /// <summary>"start" (default) or "end" — places markers on the left/right.</summary>
    [Parameter]
    public string TimelinePosition { get; set; } = "start";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Classname
        => SUIClassBuilder.Default("sui-timeline")
            .AddClass($"sui-timeline--{TimelinePosition?.ToLowerInvariant()}", !string.IsNullOrWhiteSpace(TimelinePosition))
            .AddClass(Class)
            .Build();
}
