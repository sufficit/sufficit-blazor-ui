@namespace Sufficit.Blazor.UI.Components
@inherits MudNavLink
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor.Utilities

<div @attributes="UserAttributes" class="@Classname" disabled="@Disabled" style="@Style">
    @{
        if (!OnClick.HasDelegate)
        {
            <NavLink @onclick="HandleNavigation"
                    class="@LinkClassname"
                    @attributes="@Attributes"
                    tabindex="@TabIndex"
                    Match="@Match"
                    ActiveClass="@ActiveClass">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <MudIcon Disabled="@Disabled" Icon="@Icon" Color="@IconColor" Class="@IconClassname"/>
                }
                else if (IconAsAvatar)
                {
                    <MudAvatar Color="@IconColor" Class="@IconClassname" Size="Size.Small" Variant="Variant.Outlined">@GetInitials()</MudAvatar>
                }
                <div class="mud-nav-link-text">
                    @Title
                    @ChildContent
                </div>
            </NavLink>
        }
        else
        {
            <div @onclick="OnClickHandler"
                 class="@LinkClassname"
                 tabindex="@TabIndex">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <MudIcon Disabled="@Disabled" Icon="@Icon" Color="@IconColor" Class="@IconClassname" />
                }
                else if (IconAsAvatar)
                {
                    <MudAvatar Color="@IconColor" Class="@IconClassname" Size="Size.Small" Variant="Variant.Outlined">@GetInitials()</MudAvatar>
                }
                <div Class="mud-nav-link-text">
                    @Title
                    @ChildContent
                </div>
            </div>
        }
    }
</div>
@code {

    protected new Task OnClickHandler(MouseEventArgs ev)
        => this.AsNonRenderingEventHandler<MouseEventArgs>(base.OnClickHandler).Invoke(ev);
        
    protected new Task HandleNavigation()
            => this.AsNonRenderingEventHandler(base.HandleNavigation).Invoke();
    

    protected new string IconClassname
    {
        get
        {
            var basecss = new CssBuilder("mud-nav-link-icon")
              .AddClass($"mud-nav-link-icon-default", IconColor == Color.Default)
              .Build();

            return basecss + (IconAsAvatar ? " mud-icon-root shadow" : string.Empty);
        }
    }


    public bool IconAsAvatar => string.IsNullOrEmpty(Icon) && !string.IsNullOrWhiteSpace(Title);


    [Parameter]
    public string? Title { get; set; }

    protected string GetInitials()
    {
        string result = string.Empty;
        if (!string.IsNullOrWhiteSpace(Title))
        {
            foreach (string s in Title.Split(" "))
                if (s.Length > 3)
                    result += s[0];
        }
        return result;
    }
}