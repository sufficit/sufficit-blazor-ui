@using System.Reflection
@using Sufficit.Blazor.UI.Components.UX
@typeparam T

@if (IsLoading)
{
    <SkeletonLoader Type="SkeletonLoaderType.Table" Rows="@SkeletonRows" />
}
else
{
    <MudTable T="T" Items="Items">
        <HeaderContent>
            @foreach (var prop in Properties)
            {
                <MudTh>@prop.Name</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @foreach (var prop in Properties)
            {
                <MudTd DataLabel="@prop.Name">@prop.GetValue(@context, null)</MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <TableNoRecords />
        </NoRecordsContent>
        <FooterContent>
            <MudText>Type: @Type</MudText>
            <MudText>Public Properties: @Properties.Count()</MudText>
            <MudText>Items: @Items.Count()</MudText>
        </FooterContent>
    </MudTable>
}

@code{

    [Parameter]
    [EditorRequired]
    public IEnumerable<T> Items { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public int SkeletonRows { get; set; } = 3;

    protected Type Type { get; set; } = default!;

    protected PropertyInfo[] Properties { get; set; } = [];

    protected override void OnInitialized()
    {
        Type = typeof(T);
        Properties = Type.GetProperties(BindingFlags.Public | BindingFlags.Instance);

        base.OnInitialized();
    }
}
