<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sufficit.Blazor.UI</RootNamespace>
    <AssemblyName>Sufficit.Blazor.UI</AssemblyName>
    <!-- The namespace deliberately differs from the legacy Sufficit.Blazor
         package: during migration a project may reference both, and identical
         component namespaces would make every usage ambiguous. -->
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Company>SUFFICIT SOLUÇÕES EM TECNOLOGIA DA INFORMAÇÃO</Company>
    <Authors>Sufficit</Authors>
    <RepositoryUrl>https://github.com/sufficit/sufficit-blazor-ui</RepositoryUrl>
    <!-- This project exists so CI can prove the components compile. Consumers
         copy the .razor files they need rather than taking a package
         reference, so packaging metadata is intentionally minimal. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="Vendored MudBlazor dependencies">
    <!-- The MudBlazor package reference is gone: its source now lives under
         Vendor/ and is maintained here. These are the dependencies that source
         needs. The two generators are build-time only (PrivateAssets=all), so
         they do not flow to anything consuming this project. -->
    <!-- Blazor component tooling. These used to arrive transitively through the
         MudBlazor package; removing it took them with it, and without them the
         Razor SDK discovers no components at all — every usage reports RZ10012,
         including components declared in this very project. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="3.11.0-beta1.26226.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetEscapades.EnumGenerators.Generators" Version="1.0.0-beta21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Vendor/Resources/LanguageResource.resx">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- Global using the vendored source relies on (from MudBlazor.csproj). -->
    <Using Include="MudBlazor.Utilities.StringHelpers" Static="True" />
  </ItemGroup>

</Project>
