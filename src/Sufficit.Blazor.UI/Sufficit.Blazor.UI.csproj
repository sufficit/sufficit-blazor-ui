<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup Label="Sufficit Targeting">
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Configurations>Debug;Release;Packing</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace matches the assembly. The project is self-contained:
         no MudBlazor source or package is referenced. -->
    <RootNamespace>Sufficit.Blazor.UI</RootNamespace>
    <AssemblyName>Sufficit.Blazor.UI</AssemblyName>
    <!-- The namespace deliberately differs from the legacy Sufficit.Blazor
         package: during migration a project may reference both, and identical
         component namespaces would make every usage ambiguous. -->
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Versioning">
    <VersionSuffix Condition=" '$(Configuration)' != 'Debug' ">1.$([System.DateTime]::UtcNow.ToString(yy)).$([System.DateTime]::UtcNow.ToString(MMdd)).$([System.DateTime]::UtcNow.ToString(HHmm))</VersionSuffix>
    <AssemblyVersion Condition=" '$(VersionSuffix)' == '' ">1.99.0.0</AssemblyVersion>
    <AssemblyVersion Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</AssemblyVersion>
    <Version Condition=" '$(VersionSuffix)' == '' ">1.99.0.0</Version>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(VersionSuffix)</Version>
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Product General">
    <Company>SUFFICIT SOLUÇÕES EM TECNOLOGIA DA INFORMAÇÃO</Company>
    <Authors>Hugo Castro de Deco</Authors>
    <ProductName>Sufficit Blazor UI</ProductName>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <PropertyGroup Label="Sufficit Pacote NUGET">
    <Name>Sufficit.Blazor.UI</Name>
    <PackageId>Sufficit.Blazor.UI</PackageId>
    <PackageDescription>Sufficit Blazor UI component library (SUI) — autonomous components, theme contract, no MudBlazor dependency.</PackageDescription>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/sufficit/sufficit-blazor-ui</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sufficit/sufficit-blazor-ui</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/sufficit/sufficit-blazor-ui/main/icon.png</PackageIconUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Label="Sufficit Pacote NUGET Itens">
    <None Include="../../icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="../../README.md" Pack="True" PackagePath="readme.md" />
  </ItemGroup>

  <ItemGroup Label="Blazor component tooling for .NET 9">
    <!-- The SUI components are plain Blazor: they need only the Razor SDK
         component base packages. No MudBlazor dependency. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.*" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.*" Condition="'$(TargetFramework)' == 'net9.0'" />
  </ItemGroup>

  <ItemGroup Label="Blazor component tooling for .NET 10">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>
