<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace matches the assembly. The project is self-contained:
         no MudBlazor source or package is referenced. -->
    <RootNamespace>Sufficit.Blazor.UI</RootNamespace>
    <AssemblyName>Sufficit.Blazor.UI</AssemblyName>
    <!-- The namespace deliberately differs from the legacy Sufficit.Blazor
         package: during migration a project may reference both, and identical
         component namespaces would make every usage ambiguous. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Company>SUFFICIT SOLUÇÕES EM TECNOLOGIA DA INFORMAÇÃO</Company>
    <Authors>Sufficit</Authors>
    <RepositoryUrl>https://github.com/sufficit/sufficit-blazor-ui</RepositoryUrl>
    <!-- This project exists so CI can prove the components compile. Consumers
         copy the .razor files they need rather than taking a package
         reference, so packaging metadata is intentionally minimal. -->
  </PropertyGroup>

  <ItemGroup Label="Blazor component tooling">
    <!-- The SUI components are plain Blazor: they need only the Razor SDK
         component base packages. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
    <!-- Navigation remains a compatibility adapter over the official MudBlazor
         primitives while the host still uses MudNavMenu/MudPopover. This keeps
         the rendered contract identical to production during the SUI migration. -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>
