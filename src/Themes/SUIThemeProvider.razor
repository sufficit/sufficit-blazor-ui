@namespace Sufficit.Blazor.UI.Themes
@using System
@inject IServiceProvider Services

<CascadingValue Value="@ActiveTheme">
    <div class="@WrapperClass" data-sui-theme="@(ActiveTheme.IsDark ? "dark" : "light")">
        @ChildContent
    </div>
    <style nonce="@Nonce">@((MarkupString)ToCssVars(ActiveTheme))</style>
</CascadingValue>

@code {
    /// <summary>Theme supplied directly to the provider (overrides DI).</summary>
    [Parameter]
    public ISUITheme? Theme { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// CSP nonce copied onto the inline <c>&lt;style&gt;</c> that publishes the
    /// theme tokens. Set it when the host serves
    /// <c>Content-Security-Policy: style-src 'self' 'nonce-…'</c>; without it a
    /// strict policy blocks the tokens and every component wears the fallback.
    /// </summary>
    [Parameter]
    public string? Nonce { get; set; }

    private ISUITheme? _resolved;

    protected override void OnParametersSet()
        => _resolved = Theme
            ?? Services.GetService(typeof(ISUITheme)) as ISUITheme;

    private ISUITheme ActiveTheme => _resolved ?? DefaultSUITheme.Instance;

    private string WrapperClass
        => string.IsNullOrWhiteSpace(Class) ? "sui-root" : $"sui-root {Class}";

    /// <summary>
    /// Emits the theme as CSS variables so every <c>.sui-*</c> class picks up the
    /// consuming app's palette/typography/layout. The mapping and its validation
    /// live in <see cref="SUIThemeCssWriter"/>, which rejects any value that
    /// could escape the declaration it is written into; this element only
    /// decides where the block is rendered.
    /// </summary>
    private static string ToCssVars(ISUITheme theme) => SUIThemeCssWriter.Write(theme);

    /// <summary>Where the theme tokens are published. Public so consumers and tests can assert it.</summary>
    public const string TokenSelector = SUIThemeCssWriter.TokenSelector;
}
